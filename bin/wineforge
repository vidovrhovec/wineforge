WINETRICKS = TOOLS / "winetricks"
BAKE_STATE = DATA / "bake-state.json"

# (ime, tip, vrednost, opis) — vrstni red je pomemben
BAKE_STEPS = [
    ("win10", "reg", (r"HKEY_CURRENT_USER\Software\Wine", "Version", "win10"),
