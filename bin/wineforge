    ("d3dx11", "winetricks", "d3dx11_43", "d3dx11_43"),
    ("d3dcompiler_43", "winetricks", "d3dcompiler_43", "d3dcompiler_43"),
    ("d3dcompiler_47", "winetricks", "d3dcompiler_47", "d3dcompiler_47"),
    ("vcrun2005", "winetricks", "vcrun2005", "VC++ 2005"),
    ("vcrun2008", "winetricks", "vcrun2008", "VC++ 2008"),
    ("vcrun2010", "winetricks", "vcrun2010", "VC++ 2010"),
    ("vcrun2012", "winetricks", "vcrun2012", "VC++ 2012"),
    ("vcrun2013", "winetricks", "vcrun2013", "VC++ 2013"),
    ("vcrun2022", "winetricks", "vcrun2022", "VC++ 2015-2022 (x64+x86)"),
    ("vb6run", "winetricks", "vb6run", "Visual Basic 6 runtime"),
    ("msxml3", "winetricks", "msxml3", "MSXML 3"),
    ("msxml6", "winetricks", "msxml6", "MSXML 6"),
    ("riched20", "winetricks", "riched20", "RichEdit 2.0/3.0/4.1"),
    ("xact", "winetricks", "xact", "XACT/XInput/XAudio2"),
    ("corefonts", "winetricks", "corefonts", "Microsoft core pisave"),
    ("tahoma", "winetricks", "tahoma", "Tahoma"),
    ("fontsmooth", "winetricks", "fontsmooth=rgb", "Glajenje pisav (RGB)"),
    ("webview2", "exe", ("https://go.microsoft.com/fwlink/p/?LinkId=2124703",
                         "MicrosoftEdgeWebview2Setup.exe",
                         ["/silent", "/install"]),
     "Microsoft Edge WebView2 runtime"),
    ("dotnetdesktop8", "opt", ("winetricks", "dotnetdesktop8"), ".NET Desktop Runtime 8"),
    ("dotnet48", "opt", ("winetricks", "dotnet48"), ".NET Framework 4.8"),
    ("nvidia", "nvidia", None, "NVIDIA CUDA/NVML/NVAPI (nvidia-libs)"),
    ("nvapi", "nvapi", None, "DXVK-NVAPI (DLSS, Reflex, sledenje zarkov)"),
    ("overrides", "overrides", None, "DLL override-i (DXVK/VKD3D/CUDA)"),
]


def bake_state_load():
    if BAKE_STATE.exists():
        try:
            return json.loads(BAKE_STATE.read_text())
        except json.JSONDecodeError:
            pass
    return {"done": []}


def bake_state_save(st):
    BAKE_STATE.parent.mkdir(parents=True, exist_ok=True)
    BAKE_STATE.write_text(json.dumps(st, indent=2))


def winetricks(prefix, *args, extra_env=None, timeout=None):
    # OKOLJE MORA OHRANITI gostitelja (DISPLAY, HOME, XDG_RUNTIME_DIR, ...):
    # brez teh spremenljivk vcredist/winetricks namestitve spodletijo.
    env = dict(os.environ)
    env.update(wine_env(prefix, extra_env))
    env.update({
        # pred poto sistema: vključi prenosna orodja (cabextract iz engine/tools/bin)
        "PATH": f"{TOOLSBIN}:{WINE_DIR / 'bin'}:{os.environ.get('PATH', '')}",
        "W_CACHE": str(SHARE / "verbs"),
        "WINEDLLOVERRIDES": "winemenubuilder.exe=d",
        "WINEDEBUG": "-all",
    })
    cmd = [str(WINETRICKS), "-q"] + list(args)
    p = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, timeout=timeout)
    return p.returncode, p.stdout


def download(url, dest, quiet=True, sha256=None, offline=False):
    dest = Path(dest)
    if dest.exists() and dest.stat().st_size > 0:
        if not sha256 or _sha256(dest) == (sha256 or "").lower():
            return dest
        warn(f"sha256 ne ustreza, ponovno prenašam: {dest.name}")
        dest.unlink()
    if offline:
        raise RuntimeError(f"--offline in ni v predpomnilniku: {dest.name}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(dest.suffix + ".part")
    step(f"Prenašam {dest.name}")
    code, out = run(["curl", "-L", "--fail", "--retry", "3", "-o", str(tmp), url],
                    capture=True)
    if code != 0:
        raise RuntimeError(f"prenos ni uspel: {url}\n{out[-500:]}")
    if sha256 and _sha256(tmp) != sha256.lower():
        tmp.unlink(missing_ok=True)
        raise RuntimeError(f"sha256 ne ustreza za {dest.name} ({url})")
    tmp.replace(dest)
    return dest


def _sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def cmd_bake(args):
    """Zgradi predlogo prefixa z vsemi privzetimi komponentami."""
    name = args.name or "_template"
    prefix = prefix_path(name)
    st = bake_state_load() if args.resume else {"done": []}
    (SHARE / "verbs").mkdir(parents=True, exist_ok=True)

    if not (prefix / "system.reg").exists():
        step(f"Ustvarjam osnovni prefix {prefix}")
        prefix.mkdir(parents=True, exist_ok=True)
        wine(["wineboot", "-u"], prefix=prefix, capture=True)
        wait_wineserver(prefix)
    else:
        log(f"Prefix že obstaja: {prefix} (nadaljujem)")

    for nm, kind, val, desc in BAKE_STEPS:
        if nm in st["done"]:
            log(f"  [preskočeno] {nm}")
            continue
        t0 = time.time()
        step(f"{desc}  ({nm})")
        if kind == "winetricks":
            code, out = winetricks(prefix, val)
            if code != 0:
                err(f"winetricks {val} ni uspel (koda {code})")
                print(out[-2500:])
                if not args.keep_going:
                    die("peka prekinjena")
                continue
        elif kind == "opt":
            if not args.with_dotnet:
                log("  [neobvezno, preskoceno] (uporabi --with-dotnet)")
                continue
            _sub, verb = val
            code, out = winetricks(prefix, verb)
            if code != 0:
                err(f"winetricks {verb} ni uspel (koda {code})")
                if not args.keep_going:
                    die("peka prekinjena")
                continue
        elif kind == "exe":
            url, fname, eargs = val
            exe = download(url, DEPS / fname)
            code, out = wine([str(exe)] + list(eargs), prefix=prefix, capture=True,
                             env={"WINEDEBUG": "-all"})
            if code != 0:
                err(f"{fname} se ni namestil (koda {code})")
                print(out[-2000:])
                if not args.keep_going:
                    die("peka prekinjena")
                continue
        elif kind == "reg":
            key, var, v = val
            reg_add(prefix, key, var, v)
        elif kind == "nvidia":
            link_nvidia_libs(prefix)
        elif kind == "nvapi":
            if not ensure_nvapi(prefix):
                warn("  DXVK-NVAPI ni namescen (ni povezave?) — DLSS morda ne dela")
        elif kind == "overrides":
            apply_overrides(prefix)
        st["done"].append(nm)
        bake_state_save(st)
        log(f"  gotovo v {time.time() - t0:.0f}s")

    step("Končna nega predloge")
    wineserver_kill(prefix)
    wait_wineserver(prefix, 10)
    for pat in ("drive_c/users/*/Temp/*", "drive_c/windows/temp/*",
                "drive_c/users/*/AppData/Local/Temp/*"):
        for p in prefix.glob(pat):
            try:
                shutil.rmtree(p) if p.is_dir() else p.unlink()
            except OSError:
                pass
    materialize_nvidia(prefix)
    if getattr(args, "compact", False):
        _bake_compact(prefix)
    if args.no_pack:
        log("Predloga pripravljena (brez pakiranja)")
        return 0
    step("Pakiranje predloge")
    TEMPLATES.mkdir(parents=True, exist_ok=True)
    tmp = TEMPLATES / "base-prefix.tar.zst.tmp"
    code, out = run(["tar", "--zstd", "-cf", str(tmp), "-C", str(prefix), "."], capture=True)
    if code:
        die("pakiranje ni uspelo:\n" + out[-2000:])
    tmp.replace(BASE_TEMPLATE)
    log(f"Predloga: {BASE_TEMPLATE} ({human(BASE_TEMPLATE.stat().st_size)})")
    return 0


def _bake_compact(prefix):
    """bake --compact: odstrani pomoč, Installer cache, dnevnike, pdb-je.
    Opozorilo: brez windows/Installer ne deluje popravljanje prek Kontrolne plošče."""
    step("Kompaktna predloga: odstranjujem pomoč, Installer cache, dnevnike ...")
    before = du(Path(prefix))
    victims = []
    for pat in ("drive_c/windows/Installer/*", "drive_c/windows/Help",
                "drive_c/windows/*.log", "drive_c/windows/*.tmp",
                "drive_c/users/*/Temp/*", "drive_c/windows/temp/*"):
        victims.extend(p for p in Path(prefix).glob(pat))
    for root, _dirs, files in os.walk(Path(prefix) / "drive_c"):
        for f in files:
            if f.endswith((".pdb", ".chm", ".bak", ".old")):
                victims.append(Path(root) / f)
    removed = freed = 0
    for v in victims:
        try:
            freed += v.stat().st_size if v.is_file() else 0
            if v.is_dir():
                shutil.rmtree(v, ignore_errors=True)
            else:
                v.unlink()
            removed += 1
        except OSError:
            pass
    log(f"  odstranjeno {removed} postavk, prihranjeno ~{human(freed)} "
        f"(predloga {human(before)} -> {human(du(Path(prefix)))})")


def materialize_nvidia(prefix):
    """Symlinke na engine/nvidia-libs zamenja s kopijami (predloga samostojna)."""
    for d in (Path(prefix) / "drive_c/windows/system32",
              Path(prefix) / "drive_c/windows/syswow64"):
        if not d.is_dir():
            continue
        for f in d.iterdir():
            if f.is_symlink():
                tgt = Path(os.path.realpath(f))
                try:
                    f.unlink()
                    shutil.copy2(tgt, f)
                except OSError as e:
                    warn(f"ni mogoče materializirati {f}: {e}")


# ------------------------------------------- namestitev & prenosni paket ----

# mape, ki se pri primerjavi pred/po namestitvi ignorirajo (sistemske)
SNAP_SKIP = (
    "windows/system32", "windows/syswow64", "windows/winsxs", "windows/temp",
    "windows/wow64", "windows/assembly", "windows/servicing", "windows/monitor",
    "windows/help", "windows/inf", "windows/catroot", "windows/registration",
    "windows/system32/config", "windows/prefetch", "windows/installer",
    "users/public", "users/*/temp", "users/*/Recent", "users/*/AppData/Local/Temp",
    "users/*/AppData/Local/Microsoft/Windows/INetCache",
    "users/*/AppData/Local/Microsoft/Windows/WebCache",
    "users/*/AppData/Local/Microsoft/Edge", "users/*/AppData/Local/Microsoft/OneDrive",
    "users/*/AppData/Local/CrashDumps", "users/*/AppData/Roaming/Microsoft/Windows",
    "windows/Microsoft.NET/temp",
)


def snapshot(prefix):
    """Vrne {relpot: (velikost, mtime)} za drive_c brez sistemskih map."""
    root = Path(prefix) / "drive_c"
    out = {}
    for dirpath, dirnames, filenames in os.walk(root):
        rel = os.path.relpath(dirpath, root).replace(os.sep, "/")
        dirnames[:] = [d for d in dirnames
                       if not any(Path(rel, d).match(p) or Path(rel, d).match(p + "/*")
                                  for p in SNAP_SKIP)]
        if rel == ".":
            rel = ""
        for fn in filenames:
            p = os.path.join(dirpath, fn)
            r = f"{rel}/{fn}" if rel else fn
            try:
                st = os.lstat(p)
            except OSError:
                continue
            out[r] = (st.st_size, int(st.st_mtime))
    return out


def reg_export(prefix, hive, dest):
    dest = Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        dest.unlink()
    code, out = wine(["reg", "export", hive, wine_path(dest), "/y"], prefix=prefix, capture=True)
    return code == 0 and dest.exists()


def wine_path(p):
    """Linux pot -> Windows pot (Z:\\...) za wine."""
    p = str(Path(p).resolve())
    return "Z:" + p.replace("/", "\\")


def reg_import(prefix, regfile):
    regfile = Path(regfile)
    if not regfile.exists():
        return True
    code, out = wine(["reg", "import", wine_path(regfile)], prefix=prefix, capture=True)
    return code == 0


def detect_installer(path):
    """Ugani tih način namestitve glede na tip namestitvenega programa."""
    p = Path(path)
    data = p.read_bytes()[:400000] if p.suffix.lower() == ".exe" else b""
    name = p.name.lower()
    if p.suffix.lower() == ".msi":
        return "msi", ["/qn", "/norestart"]
    if b"Inno Setup" in data or "innosetup" in name:
        return "inno", ["/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/SP-"]
    if b"Nullsoft" in data or b"NSIS" in data:
        return "nsis", ["/S"]
    if b"InstallShield" in data:
        return "installshield", ["/s", "/v/qn"]
    if b"WixBundle" in data or "wixburn" in name or "burn" in name:
        return "wix", ["/quiet", "/norestart"]
    if (b"Qt Installer Framework" in data or b"installerframework" in data.lower()
            or "qt-unified" in name or name.startswith("qtcreator")):
        return "qtifw", ["--accept-licenses", "--default-answer",
                         "--confirm-command", "install"]
    if b"Squirrel" in data:
        return "squirrel", ["--silent"]
    return "unknown", []


# --------------------------------------------------- WebView2 (znana past) ----

# Programi, ki za vmesnik uporabljajo Microsoft Edge WebView2. V Wineu se
# takšno okno NE izriše: Wine še ne podpira poti D3D11 shared-texture +
# DirectComposition, po kateri Chromium pošilja sliko v okno (Wine bug 59370).
# Aplikacija se sicer zažene (v dnevniku piše Startup.Completed), uporabnik pa
# vidi črno okno z belim kvadratom ali prazno belo okno.
WEBVIEW2_MARKERS = (b"msedgewebview2", b"WebView2", b"webview2loader",
                    b"EBWebView", b"eglv2", b"MicrosoftEdgeWebview2Setup")
WEBVIEW2_NAMES = ("epicgameslauncher", "epicgameslaunchersetup", "eglv2",
                  "msteams", "microsoftteams", "newoutlook", "outlook",
                  "edgewebview", "webview2")


def detect_webview2(path, scan_limit=400 * 1024 * 1024):
    """Vrni True, če je program/namestitvenik vezan na WebView2."""
    p = Path(path)
    if p.suffix.lower() not in (".exe", ".msi", ".msix", ".appx", ""):
        return False
    name = p.stem.lower().replace("-", "").replace("_", "").replace(" ", "")
    if any(n in name for n in WEBVIEW2_NAMES):
        return True
    try:
        with p.open("rb") as f:
            read = 0
            tail = b""
            while read < scan_limit:
                chunk = f.read(1 << 20)
                if not chunk:
                    break
                read += len(chunk)
                buf = tail + chunk
                if any(m in buf for m in WEBVIEW2_MARKERS):
                    return True
                tail = buf[-64:]
    except OSError:
        return False
    return False


def warn_webview2(path):
    """Opozori, da WebView2 program v Wineu ne bo prikazal vsebine."""
    warn(f"'{Path(path).name}' uporablja Microsoft Edge WebView2 za svoj vmesnik.")
    warn("  V Wineu se takšno okno NE izriše (Wine bug 59370: manjka podpora")
    warn("  D3D11 shared-texture + DirectComposition poti, po kateri Chromium")
    warn("  pošilja sliko v okno). Program se zažene, a ostane črno/belo okno.")
    warn("  Preizkušeno in ne pomaga: --disable-gpu, --disable-direct-composition,")
    warn("  --in-process-gpu, --no-sandbox, --use-angle=swiftshader, brez DXVK,")
    warn("  svež profil WebView2, onemogočen nvapi/nvml.")
    warn("  Rešitev: uporabi Linux različico programa, če obstaja.")
    warn("    Epic Games Launcher: https://launcher.epicgames.com/ (uradni")
    warn("      Linux AppImage/deb) ali Heroic Games Launcher (legendary).")
    warn("    Teams/Outlook: PWA v brskalniku ali uradni Linux odjemalec.")


def _popen_stream(cmd, env=None, log_path=None):
    """Požene ukaz z živim izpisom, zbira vrstice in (če je podan) piše dnevnik."""
    lines = []
    fh = None
    if log_path:
        try:
            Path(log_path).parent.mkdir(parents=True, exist_ok=True)
            fh = open(log_path, "w", encoding="utf-8", errors="replace")
        except OSError:
            fh = None
    p = subprocess.Popen(cmd, env=env, text=True, bufsize=1,
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         errors="replace")
    try:
        for line in p.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            lines.append(line)
            if fh:
                fh.write(line)
                fh.flush()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            p.stdout.close()
        except Exception:
            pass
        if fh:
            fh.close()
    return p.wait(), lines


def _summarize_install_errors(lines):
    """Po namestitvi povzame Wine/storitvene napake ('err:') iz izpisa."""
    bad = [l.strip() for l in lines if ":err:" in l]
    if not bad:
        return
    warn(f"namestitev je zabeležila {len(bad)} vrstic z napakami Wine/storitev:")
    shown, rest = [], 0
    for i, l in enumerate(bad):
        key = re.sub(r"^\w*:\w+:", "", l).strip()[:140]
        if key not in shown:
            shown.append(key)
            log("   " + key)
        if len(shown) >= 8:
            rest = len(bad) - i - 1
            break
    if rest:
        log(f"   ... in še {rest} vrstic z napakami")
    warn("  pomeni: nekateri koraki (storitve/PowerShell/skripte) NISO delovali, zato bo\n"
         "  program po zagonu utegnil prikazati napako — glej vrstice zgoraj.")


def cmd_install(args):
    """Namesti program v začasen prefix, zajame spremembe in naredi prenosno aplikacijo."""
    inst = Path(args.installer).expanduser().resolve()
    if not inst.exists():
        die(f"Namestitveni program ne obstaja: {inst}")
    name = args.name or slugify(re.sub(r"(?i)(setup|install|installer|x64|x86|_|-)", "",
                                       inst.stem))
    staging = PREFIXES / f"_staging-{name}"
    if staging.exists():
        shutil.rmtree(staging)

    step("Pripravljam začasen prefix iz predloge")
    prefix_new(staging.name, quiet=True)

    try:
        kind, silent = detect_installer(inst)
    except Exception as e:
        warn(f"ne morem ugotoviti tipa namestitvenega programa: {e}")
        kind, silent = "unknown", []
    if detect_webview2(inst):
        warn_webview2(inst)
    log(f"  zaznan tip: {kind}  ({' '.join(silent) or 'ročna namestitev'})")

    step("Zajemam stanje pred namestitvijo")
    before = snapshot(staging)

    step("Nameščam program")
    cmd = [str(WINE), str(inst)] + (silent if not args.interactive else [])
    LOGS.mkdir(parents=True, exist_ok=True)
    install_log = LOGS / f"install-{name}-{time.strftime('%Y%m%d-%H%M%S')}.log"
    # err/warn morata videti: brez tega povzetek napak po namestitvi ne gre
    env = {**os.environ, **wine_env(staging, {"WINEDEBUG": "err+all,warn+all"})}
    code, out_lines = _popen_stream(cmd, env=env, log_path=install_log)
    _summarize_install_errors(out_lines)
    log(f"  dnevnik namestitve: {install_log}")
    wineserver_kill(staging)
    wait_wineserver(staging, 30)

    step("Zajemam stanje po namestitvi")
    after = snapshot(staging)
    changed = {}
    for path, meta in after.items():
        if before.get(path) != meta:
            changed[path] = meta
    removed = [p for p in before if p not in after]
    log(f"  novih/spremenjenih datotek: {len(changed)}, odstranjenih: {len(removed)}")

    if not args.keep_staging:
        wineserver_kill(staging)
        wait_wineserver(staging, 10)
        shutil.rmtree(staging, ignore_errors=True)

    adir = app_dir(name)
    if adir.exists():
        shutil.rmtree(adir)
    root = adir / "root"
    total = 0
    for rel in sorted(changed):
        src = Path(staging) / "drive_c" / rel
        dst = root / "drive_c" / rel
        try:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            total += dst.stat().st_size
        except OSError as e:
            warn(f"  {rel}: {e}")
    log(f"  preneseno v aplikacijo: {human(total)}")

    step("Izvoz registra")
    regs = []
    for hive, fname in (("HKCU", "user.reg"), ("HKLM", "machine.reg")):
        dest = adir / fname
        if reg_export(staging, hive, dest):
            txt = dest.read_text(errors="surrogateescape")
            # poti staging prefixa -> relativen C:\ (prenosno)
            txt = txt.replace(wine_path(staging / "drive_c"), r"C:")
            dest.write_text(txt, errors="surrogateescape")
            regs.append(fname)

    # najdi glavni exe
    exes = []
    for rel in changed:
        if rel.lower().endswith(".exe"):
            exes.append(rel)
    main = None
    if args.exe:
        main = args.exe
    else:
        cands = [e for e in exes if "/" in e and "unins" not in e.lower()
                 and "vcredist" not in e.lower()]
        cands.sort(key=lambda e: (len(e.split("/")), len(e)))
        main = cands[0] if cands else (exes[0] if exes else None)
    if not main:
        die("v namestitvi nisem našel nobenega .exe — uporabi --exe")

    meta = {
        "name": name,
        "exe": f"root/drive_c/{main}",
        "prefix": str(PREFIXES / name),
        "args": args.args or [],
        "env": {},
        "installed_from": inst.name,
        "installer_type": kind,
        "registry": regs,
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    app_save(meta)
    auto_scale(name, meta)
    log(f"\nAplikacija '{name}' pripravljena. Zaženi: wineforge run {name}")
    log(f"Velikost: {human(du(adir))}   (prefix se ustvari ob prvem zagonu)")
    if not getattr(args, "no_shortcut", False):
        for p in _desktop_write(name, places=("menu", "desktop")):
            log(f"Ikona (klik): {p}")
    return 0


def prepare_app_prefix(name):
    """Ustvari/posodobi prefix za aplikacijo: predloga + datoteke + register."""
    meta = app_load(name)
    if not meta:
        die(f"Neznana aplikacija: {name}")
    prefix = Path(meta["prefix"])
    adir = app_dir(name)
    marker = adir / ".prepared"
    fresh = not (prefix / "system.reg").exists()
    up_to_date = (marker.exists()
                  and marker.stat().st_mtime > (adir / "app.json").stat().st_mtime)
    if up_to_date:
        # preveri, da vsi vključeni programi res obstajajo v prefixu
        for inc in meta.get("include", []):
            if not (prefix / "drive_c" / inc["win"]).exists():
                up_to_date = False
                break
    if not fresh and up_to_date:
        return prefix

    if fresh:
        step(f"Ustvarjam prefix za {name}")
        prefix_new(prefix.name, quiet=True)
    else:
        wineserver_kill(prefix)
        wait_wineserver(prefix, 15)

    root = adir / "root"
    if root.is_dir():
        step("Kopiram datoteke programa v prefix")
        run(["cp", "-a", f"{root}/.", str(prefix) + "/"], capture=True)

    # zunanje mape programa (npr. celotna mapa aplikacije) vpne kot symlink
    for inc in meta.get("include", []):
        local = adir / "inc" / Path(inc["src"]).name
        src = local if local.exists() else Path(inc["src"])
        if not src.exists():
            warn(f"mapa ne obstaja: {src}")
            continue
        dst = Path(prefix) / "drive_c" / inc["win"]
        dst.parent.mkdir(parents=True, exist_ok=True)
        if dst.is_symlink():
            dst.unlink()
        elif dst.exists():
            shutil.rmtree(dst, ignore_errors=True)
        dst.symlink_to(src)
        log(f"  {inc['win']} -> {src}")

    for reg in meta.get("registry", []):
        reg_import(prefix, adir / reg)

    # dodatne sistemske datoteke (npr. nvidia-smi shim)
    sys32 = Path(prefix) / "drive_c/windows/system32"
    for spec in meta.get("sys32", []):
        cands = [Path(spec)] if Path(spec).is_absolute() else []
        cands.append(adir / spec)
        base = Path(spec).name
        for inc in meta.get("include", []):
            cands.append(adir / "inc" / Path(inc["src"]).name / base)
            cands.append(Path(inc["src"]) / base)
            # poišči rekurzivno v mapi aplikacije
            for root_dir, _dirs, files in os.walk(Path(inc["src"])):
                if base in files:
                    cands.append(Path(root_dir) / base)
                    break
        for c in cands:
            if c.exists():
                shutil.copy2(c, sys32 / c.name)
                log(f"  system32/{c.name}")
                break

    marker.write_text(time.strftime("%Y-%m-%dT%H:%M:%S"))
    return prefix


def cmd_installer_exe(args):
    return 0


def cmd_pack(args):
    """Naredi samostojen prenosni paket (motor + aplikacija)."""
    meta = app_load(args.name)
    if not meta:
        die(f"Neznana aplikacija: {args.name}")
    out = Path(args.out).expanduser().resolve() / slugify(args.name)
    if out.exists() and not args.force:
        die(f"{out} že obstaja (uporabi --force)")
    step(f"Pakiram v {out}")
    out.mkdir(parents=True, exist_ok=True)

    # 0. čiščenje ostankov prejšnjega paketa (da ne nastanejo gnezda engine/engine)
    for part in ("engine", "bin", "share", "apps", "prefixes"):
        d = out / part
        if d.exists() and args.force:
            shutil.rmtree(d, ignore_errors=True)

    # 1. motor (hardlink, če je na istem disku -> brez porabe prostora)
    for part in ("engine", "bin", "share"):
        src = FORGE / part
        if not src.exists():
            continue
        dst = out / part
        code, _ = run(["cp", "-al", str(src), str(dst)], capture=True)
        if code:
            run(["cp", "-a", str(src), str(dst)], capture=True)

    # 1b. dokumentacija
    for doc in ("README.md",):
        if (FORGE / doc).exists():
            shutil.copy2(FORGE / doc, out / doc)
    if (FORGE / "docs").is_dir():
        run(["cp", "-al", str(FORGE / "docs"), str(out / "docs")], capture=True)

    # 2. aplikacija + njen prefix
    step("Aplikacija in prefix")
    adir = app_dir(args.name)
    for inc in meta.get("include", []):
        src = Path(inc["src"])
        if not src.exists():
            warn(f"manjka: {src}")
            continue
        dst = adir / "inc" / src.name
        if dst.exists() or dst.is_symlink():
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        step(f"Vključujem {src.name} ({human(du(src))})")
        code, _ = run(["cp", "-al", str(src), str(dst)], capture=True)
        if code:
            run(["cp", "-a", str(src), str(dst)], capture=True)
    (out / "apps").mkdir(exist_ok=True)
    run(["cp", "-al", str(adir), str(out / "apps" / adir.name)], capture=True)
    prefix = Path(meta["prefix"])
    if (prefix / "system.reg").exists() and not args.no_prefix:
        (out / "prefixes").mkdir(exist_ok=True)
        wineserver_kill(prefix)
        wait_wineserver(prefix, 20)
        step(f"Kopiram prefix ({human(du(prefix))})")
        run(["cp", "-al", str(prefix), str(out / "prefixes" / prefix.name)], capture=True)

    # 2b. prenosni zapis app.json (relativne poti) + popravi symlinke v prefixu
    bundled_app = out / "apps" / adir.name
    bundled_meta = json.loads((bundled_app / "app.json").read_text())
    if bundled_meta.get("prefix"):
        bundled_meta["prefix"] = Path(meta["prefix"]).name
    for inc in bundled_meta.get("include", []):
        inc["src"] = "inc/" + Path(inc["src"]).name
    exe = Path(bundled_meta.get("exe", ""))
    for inc in bundled_meta.get("include", []):
        base = Path(inc["src"]).name
        if exe.is_absolute() and str(exe).startswith(str(Path(meta["include"][0]["src"]))):
            rel = exe.relative_to(Path(meta["include"][0]["src"]))
            bundled_meta["exe"] = f"inc/{base}/{rel}"
            break
    (bundled_app / "app.json").write_text(json.dumps(bundled_meta, indent=2, ensure_ascii=False))
    # symlinki znotraj prefixa naj kažejo na vključeno kopijo v paketu
    bprefix = out / "prefixes" / Path(meta["prefix"]).name
    for inc in bundled_meta.get("include", []):
        dst = bprefix / "drive_c" / inc["win"]
        target = bundled_app / inc["src"]
        if dst.is_symlink() or dst.exists():
            if dst.is_symlink():
                dst.unlink()
            else:
                shutil.rmtree(dst, ignore_errors=True)
        if target.exists() and bprefix.exists():
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.symlink_to(os.path.relpath(target, dst.parent))

    # 3. zaganjalnik
    launcher = out / "run.sh"
    launcher.write_text(f'''#!/bin/sh
# Prenosni zaganjalnik WineForge — deluje iz katerekoli mape/USB ključa
HERE=$(cd "$(dirname "$0")" && pwd)
export WINEFORGE_DIR="$HERE"
exec "$HERE/bin/wineforge" run "{args.name}" "$@"
''')
    launcher.chmod(0o755)
    # „appimage" en-klik: enkrat poženi register.sh → ikona na namizju in v meniju
    reg = out / "register.sh"
    reg.write_text(f'''#!/bin/sh
# Ustvari ikono (namizje + meni) za to aplikacijo. Poženi ENKRAT.
HERE=$(cd "$(dirname "$0")" && pwd)
exec "$HERE/bin/wineforge" desktop "{args.name}"
''')
    reg.chmod(0o755)
    (out / "README.txt").write_text(README_TXT.format(name=args.name))
    if getattr(args, "desktop", False):
        step("Ustvarjam ikono za paket (kaže na to mapo — ok, če se premika)")
        run([str(out / "bin" / "wineforge"), "desktop", args.name])
    total = du(out)
    log(f"Paket: {out}  ({human(total)})")
    if args.compress:
        step("Stiskam v tar.zst")
        arch = out.with_suffix(".tar.zst")
        run(["tar", "--zstd", "-cf", str(arch), "-C", str(out.parent), out.name], capture=True)
        log(f"Arhiv: {arch} ({human(arch.stat().st_size)})")
    return 0


def cmd_remove(args):
    meta = app_load(args.name)
    if not meta:
        die("Neznana aplikacija")
    if args.keep_prefix is False:
        p = Path(meta["prefix"])
        if (p / "system.reg").exists():
            wineserver_kill(p)
            wait_wineserver(p, 10)
            shutil.rmtree(p, ignore_errors=True)
    shutil.rmtree(app_dir(args.name), ignore_errors=True)
    log(f"Odstranjeno: {args.name}")
    return 0


def _doctor_fix():
    """doctor --fix: popravi, kar se da popraviti brez vprašanj."""
    step("doctor --fix — popravljam")
    if setup_missing():
        cmd_setup(_ns_setup())
    if media_missing()[0]:
        media_fix()
    for name in list_prefixes():
        p = prefix_path(name)
        if not (p / "system.reg").exists():
            continue
        log(f"  {name}: ustavim wineserver, čistim temp, obnovim override-e")
        wineserver_kill(p)
        wait_wineserver(p, 15)
        for pat in ("drive_c/users/*/Temp/*", "drive_c/windows/temp/*",
                    "drive_c/users/*/AppData/Local/Temp/*", "drive_c/windows/*.log"):
            for f in p.glob(pat):
                try:
                    shutil.rmtree(f) if f.is_dir() else f.unlink()
                except OSError:
                    pass
        setup_defaults(p, quiet=True)
    log(f"  {len(list_prefixes())} prefixov pregledanih")
    step("Popravljeno. Ponovno preveri: wineforge doctor")


def _doctor_cleanup():
    """Začasni _doctor prefix odstrani (ne rabi ~1,5 GB)."""
    p = prefix_path("_doctor")
    if (p / "system.reg").exists():
        wineserver_kill(p)
        wait_wineserver(p, 5)
        shutil.rmtree(p, ignore_errors=True)


def cmd_doctor(args):
    step("WineForge doctor")
    ok = True

    def line(label, value, good=None):
        nonlocal ok
        mark = "\033[1;32m✓\033[0m" if good is not False else "\033[1;31m✗\033[0m"
        if good is False:
            ok = False
        print(f" {mark} {label:<28} {value}")

    if getattr(args, "fix", False):
        _doctor_fix()

    line("motor", str(FORGE))
    if WINE.exists():
        code, out = run([str(WINE), "--version"], capture=True)
        line("wine", out.strip() or "?", code == 0)
        # 32-bit podpora
        code, out = run([str(WINE), "wineboot", "-h"], capture=True)
        line("wineboot", "ok" if code == 0 else "napaka", code == 0)
    else:
        line("wine", "manjka engine/wine", False)
    line("nvidia-libs", "da" if NVLIBS.is_dir() else "ne", NVLIBS.is_dir())
    line("predloga prefixa", "da" if BASE_TEMPLATE.exists() else "ne",
         BASE_TEMPLATE.exists())
    # GPU
    if shutil.which("nvidia-smi"):
        code, out = run(["nvidia-smi", "--query-gpu=name,memory.total,driver_version",
                         "--format=csv,noheader"], capture=True)
        line("GPU (nvidia-smi)", out.strip().splitlines()[0] if out.strip() else "?", code == 0)
    else:
        line("GPU (nvidia-smi)", "ni najden", None)
    # Vulkan
    if shutil.which("vulkaninfo"):
        code, out = run(["vulkaninfo", "--summary"], capture=True)
        gpu = [l.strip() for l in out.splitlines() if "deviceName" in l]
        line("Vulkan", gpu[0] if gpu else "ok", code == 0)
    else:
        line("Vulkan", "vulkaninfo ni nameščen (ni nujno)", None)
    # CUDA v Wine
    if NVLIBS.is_dir():
        cudatest = NVLIBS / "bin" / "cudatest.exe"
        if cudatest.exists():
            p = prefix_path("_doctor")
            if not (p / "system.reg").exists():
                prefix_new("_doctor", quiet=True)
            code, out = wine([str(cudatest)], prefix=p, capture=True)
            has = "cuInit success" in out
            dev = ""
            for l in out.splitlines():
                if "RTX" in l or "GeForce" in l or "Radeon" in l:
                    dev = l.strip()
                    break
            line("CUDA v Wine", (dev or ("ok" if has else "ne dela")), has)
    # NVAPI (DLSS / Reflex / sledenje zarkov) — pogledamo obstojece prefixe
    var = {}
    for nm in list_prefixes():
        if nm.startswith("_"):
            continue
        var.setdefault(nvapi_variant(prefix_path(nm)), []).append(nm)
    if not var:
        line("NVAPI (DLSS/RT)", "ni prefixov (vgradi se sam ob ustvarjanju)", None)
    else:
        slabi = [n for k, ns in var.items() if k != "dxvk-nvapi" for n in ns]
        line("NVAPI (DLSS/RT)",
             "DXVK-NVAPI v vseh prefixih" if not slabi else
             f"{', '.join(slabi)}: Windows nvapi → wineforge doctor --fix",
             not slabi)
    # predvajanje videa (Media Foundation prek GStreamerja)
    miss, why = media_missing()
    if why:
        line("predvajanje videa", why, None)
    else:
        line("predvajanje videa",
             "v redu" if not miss else
             "manjka: " + ", ".join(n for n, _ in miss) + " → wineforge media --fix",
             not miss)
    # diski
    devs = optical_devices()
    loops = [m for m in _mounts() if m[2] in DISC_FSTYPES]
    line("optični pogon",
         f"{len(devs)} naprav" if devs else "ni naprave (ISO: wineforge disc --iso)",
         None)
    if loops:
        line("montirani diski", ", ".join(m[1] for m in loops), None)
    log()
    if not getattr(args, "keep_prefix", False):
        _doctor_cleanup()
    return 0 if ok else 1




def is_electron(exe_path):
    """Preprosto zazna Electron/Chromium aplikacijo po datotekah ob exe-ju."""
    try:
        d = Path(exe_path).parent
    except Exception:
        return False
    for f in ("resources.pak", "v8_context_snapshot.bin", "icudtl.dat", "libEGL.dll",
              "chrome_100_percent.pak"):
        if (d / f).exists():
            return True
    return False


def cmd_scale(args):
    """Nastavi velikost vmesnika za aplikacijo (DPI za Win32, zoom za Electron)."""
    meta = app_load(args.name)
    if not meta:
        die(f"Neznana aplikacija: {args.name}")
    pct = args.percent
    if pct < 50 or pct > 400:
        die("Odstotek naj bo med 50 in 400")
    factor = pct / 100.0
    prefix = Path(meta["prefix"])
    if not (prefix / "system.reg").exists():
        prefix_new(prefix.name, quiet=True)

    exe = Path(meta["exe"])
    if not exe.is_absolute():
        exe = app_dir(args.name) / exe
    # poišči Electron/Chromium binarko (tudi v podmapah, npr. App/<Ime>/<Ime>.exe)
    electron = exe if is_electron(exe) else None
    if not electron:
        try:
            for cand in sorted(exe.parent.rglob("*.exe"), key=lambda x: -x.stat().st_size):
                if is_electron(cand):
                    electron = cand
                    break
        except OSError:
            pass

    step(f"Nastavljam {pct}% za {args.name}")
    if electron:
        # Chromium/Electron: skaliranje cele strani (pisave + ikone)
        reg_add(prefix, r"HKEY_CURRENT_USER\\Control Panel\\Desktop", "LogPixels", "96")
        args_list = [a for a in meta.get("args", [])
                     if not str(a).startswith("--force-device-scale-factor")]
        if abs(factor - 1.0) > 0.01:
            args_list.append(f"--force-device-scale-factor={factor:g}")
        meta["args"] = args_list
        app_save(meta)
        log(f"  Electron/Chromium ({electron.name}) -> --force-device-scale-factor={factor:g}")
    else:
        dpi = int(round(96 * factor))
        reg_add(prefix, r"HKEY_CURRENT_USER\\Control Panel\\Desktop", "LogPixels", str(dpi))
        reg_add(prefix, r"HKEY_CURRENT_USER\\Control Panel\\Desktop", "Win8DpiScaling", "1")
        log(f"  Win32 program -> LogPixels = {dpi} ({pct}%)")
    wineserver_kill(prefix)
    wait_wineserver(prefix, 15)
    log("")
    log(f"Zaženi: wineforge run {args.name}")
    return 0



def cmd_config(args):
    cfg = load_config()
    if args.electron_scale is not None:
        cfg["electron_scale"] = float(args.electron_scale)
    if args.win32_dpi_scale is not None:
        cfg["win32_dpi_scale"] = float(args.win32_dpi_scale)
    if args.auto_scale is not None:
        cfg["auto_scale"] = args.auto_scale == "on"
    save_config(cfg)
    log("Nastavitve (data/config.json):")
    for k, v in cfg.items():
        log(f"  {k} = {v}")
    if any(v is not None for v in (args.electron_scale, args.win32_dpi_scale, args.auto_scale)):
        log("")
        log("Uporabljeno ob naslednjem zagonu programa.")
    return 0

# ------------------------------------------- samodejna priprava (setup) ----
# Ob prvem zagonu na novem računalniku se MANJKAJOČI deli prenesejo sami:
# Wine, nvidia-libs, winetricks, prenosni cabextract in predloga prefixa.
# Nič ročnega — mapa ostane prenosna (poti so relativne).

WINE_VER = "11.22"
WINE_BUILD = f"wine-{WINE_VER}-amd64-wow64"
WINE_URL = (f"https://github.com/Kron4ek/Wine-Builds/releases/download/"
            f"{WINE_VER}/{WINE_BUILD}.tar.xz")
WINE_SUMS = (f"https://github.com/Kron4ek/Wine-Builds/releases/download/"
             f"{WINE_VER}/sha256sums.txt")
NVL_URL = ("https://github.com/SveSop/nvidia-libs/releases/download/"
           "v1.0.5/nvidia-libs-v1.0.5.tar.xz")
WT_URL = ("https://raw.githubusercontent.com/Winetricks/winetricks/"
          "master/src/winetricks")
CAB_URL = ("https://archive.archlinux.org/packages/c/cabextract/"
           "cabextract-1.11-3-x86_64.pkg.tar.zst")

# "en prenos": engine/ + predloga skupaj (GitHub Release) — na novem
# računalniku potem ničesar več ni treba peči/prenašati posamično.
ENGINE_RELEASE = "0.1.0"
ENGINE_BUNDLE = f"engine-{ENGINE_RELEASE}.tar.zst"
ENGINE_URL = (f"https://github.com/vidovrhovec/wineforge/releases/download/"
              f"engine-{ENGINE_RELEASE}/{ENGINE_BUNDLE}")
# sha256 zaklenjene izdaje; ju SKUPAJ spremenimo ob novem bundlu
# (vrednost preveri s: sha256sum engine-0.1.0.tar.zst / gh release view)
ENGINE_SHA256 = "fcb19b1e36e5f19832947f6149d7754a31f1e0c0d4154193964c87e93206c20e"
MANIFEST = DATA / "engine-manifest.json"

CABEXTRACT = TOOLSBIN / "cabextract"
ICON_NAME = "wineforge"
ICON_SRC = SHARE / "icons" / f"{ICON_NAME}.svg"

_DIALOG = [None]


def cabextract_bin():
    """Cabextract: sistemskega ali prenosnega iz engine/tools/bin."""
    for cand in (shutil.which("cabextract"), str(CABEXTRACT)):
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def setup_status():
    return {
        "wine": os.access(WINE, os.X_OK),
        "winetricks": os.access(TOOLS / "winetricks", os.X_OK),
        "nvidia-libs": (NVLIBS / "x64" / "nvcuda.dll").exists(),
        "cabextract": cabextract_bin() is not None,
        "predloga": BASE_TEMPLATE.exists(),
    }


def setup_missing():
    return [k for k, v in setup_status().items() if not v]


def _sha256_release():
    """sha256 iz Kron4ek sha256sums.txt za prenosljiv Wine."""
    sfile = DEPS / "wine-sha256sums.txt"
    try:
        run(["curl", "-fsSL", "--retry", "3", "-o", str(sfile), WINE_SUMS],
            capture=True)
        sums = {}
        for line in sfile.read_text().splitlines():
            parts = line.split()
            if len(parts) == 2:
                sums[parts[1].lstrip("*")] = parts[0]
        return sums
    except OSError:
        return {}


def _setup_wine(offline=False):
    if os.access(WINE, os.X_OK):
        return
    machine = os.uname().machine
    if machine not in ("x86_64", "amd64"):
        die(f"WineForge potrebuje 64-bitni x86_64 (tvoj: {machine})")
    fname = WINE_BUILD + ".tar.xz"
    step(f"Prenašam Wine {WINE_VER} (prenosljiv, ~100 MB)")
    sums = {} if offline else _sha256_release()
    dest = download(WINE_URL, DEPS / fname, sha256=sums.get(fname), offline=offline)
    step("Razpakiram engine/wine ...")
    work = DEPS / "wine-untar"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    code, out = run(["tar", "-xJf", str(dest), "-C", str(work)], capture=True)
    if code:
        die("razpakiranje Wine ni uspelo:\n" + out[-800:])
    inner = next((p for p in work.iterdir() if p.is_dir()), None)
    if not inner:
        die("nepričakana vsebina Wine arhiva")
    if WINE.exists():
        shutil.rmtree(WINE, ignore_errors=True)
    ENGINE.mkdir(parents=True, exist_ok=True)
    shutil.move(str(inner), str(WINE))
    shutil.rmtree(work, ignore_errors=True)


def _setup_nvidialibs(offline=False):
    if (NVLIBS / "x64" / "nvcuda.dll").exists():
        return
    step("Prenašam nvidia-libs (CUDA/NVML/NVAPI, ~3 MB)")
    dest = download(NVL_URL, DEPS / "nvidia-libs.tar.xz", offline=offline)
    work = DEPS / "nvl-untar"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    code, out = run(["tar", "-xJf", str(dest), "-C", str(work)], capture=True)
    if code:
        warn("razpakiranje nvidia-libs ni uspelo — CUDA ne bo deloval")
        return
    src = next((p for p in work.glob("nvidia-libs*") if p.is_dir()), None)
    if src:
        NVLIBS.mkdir(parents=True, exist_ok=True)
        shutil.copytree(src, NVLIBS, dirs_exist_ok=True)
    shutil.rmtree(work, ignore_errors=True)


def _setup_winetricks(offline=False):
    if os.access(TOOLS / "winetricks", os.X_OK):
        return
    step("Prenašam winetricks")
    TOOLS.mkdir(parents=True, exist_ok=True)
    download(WT_URL, TOOLS / "winetricks", offline=offline)
    (TOOLS / "winetricks").chmod(0o755)


def _setup_cabextract(offline=False):
    if cabextract_bin():
        return
    # sistemskega ne moremo nameščati (brez roota) → prenosni v engine/tools/bin
    step("Prenašam prenosni cabextract")
    pkg = DEPS / "cabextract.pkg.tar.zst"
    download(CAB_URL, pkg, offline=offline)
    work = DEPS / "cabextract-untar"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    code, out = run(["tar", "--zstd", "-xf", str(pkg), "-C", str(work)],
                    capture=True)
    if code:
        warn("cabextract ni bilo mogoče razpakiti (potreben tar --zstd):\n" + out[-400:])
        return
    src = work / "usr" / "bin" / "cabextract"
    if src.exists():
        TOOLSBIN.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, CABEXTRACT)
        CABEXTRACT.chmod(0o755)
    shutil.rmtree(work, ignore_errors=True)


def _setup_bundle(offline=False):
    """Najprej poskuša EN prenos: engine/ + share/templates/ (GitHub Release)."""
    if os.access(WINE, os.X_OK) and BASE_TEMPLATE.exists():
        return True
    dest = DEPS / ENGINE_BUNDLE
    try:
        download(ENGINE_URL, dest, sha256=ENGINE_SHA256, offline=offline)
    except RuntimeError as e:
        warn(f"paket {ENGINE_BUNDLE} ni na voljo ({e}) — sestavim motor iz delov")
        return False
    step("Razpakiram paket engine + predloga (en prenos) ...")
    code, out = run(["tar", "--zstd", "-xf", str(dest), "-C", str(FORGE)],
                    capture=True)
    if code:
        warn("razpakiranje paketa ni uspelo:\n" + out[-500:])
        return False
    return os.access(WINE, os.X_OK) and BASE_TEMPLATE.exists()


def manifest_paths():
    paths = []
    for root, _dirs, files in os.walk(ENGINE):
        for f in files:
            p = Path(root) / f
            if not p.is_symlink():
                paths.append(p)
    if BASE_TEMPLATE.exists():
        paths.append(BASE_TEMPLATE)
    for winetricks_f in (TOOLS / "winetricks", CABEXTRACT):
        if winetricks_f.exists() and not winetricks_f.is_symlink():
            paths.append(winetricks_f)
    return sorted(set(paths))


def manifest_build():
    """sha256 vseh datotek motorja → data/engine-manifest.json."""
    step("Pišem manifest motorja (sha256) ...")
    data = {}
    for p in manifest_paths():
        try:
            data[str(p.relative_to(FORGE))] = [p.stat().st_size, _sha256(p)]
        except OSError:
            continue
    MANIFEST.parent.mkdir(parents=True, exist_ok=True)
    MANIFEST.write_text(json.dumps({
        "version": VERSION,
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "files": data,
    }))
    log(f"  zapisanih datotek: {len(data)}")
    return 0


def manifest_verify():
    """Preveri, ali je bil motor poškodovan (napak prenos, USB, sistemski pomik)."""
    if not MANIFEST.exists():
        warn("manifesta ni — najprej: wineforge setup --manifest")
        return 1
    step("Preverjam integriteto motorja")
    files = json.loads(MANIFEST.read_text()).get("files", {})
    bad, missing = [], []
    for rel, (size, digest) in files.items():
        p = FORGE / rel
        if not p.exists():
            missing.append(rel)
        elif p.stat().st_size != size or _sha256(p) != digest:
            bad.append(rel)
    ok = not bad and not missing
    for rel in missing[:10]:
        err(f"manjka: {rel}")
    for rel in bad[:10]:
        err(f"spremenjena/pokvarjena: {rel}")
    if missing or bad:
        warn(f"skupaj težav: {len(missing)} manjka, {len(bad)} spremenjenih")
        log("  Popravi z: wineforge setup   (prenese samo poškodovane dele)")
        return 1
    log(f"  OK — {len(files)} datotek, manifest ustreza")
    return 0


def ensure_ready():
    """Če manjka kaj od potrebnega, pripravi samodejno (prvi zagon na novem PC)."""
    missing = setup_missing()
    if not missing:
        return True
    warn(f"Motor nepripravljen (manjka: {', '.join(missing)}) — pripravljam ...")
    cmd_setup(_ns_setup())
    return not setup_missing()


def _ns_setup(**kw):
    d = dict(check=False, no_bake=False, with_dotnet=False, desktop=False,
             offline=False, parts=False, verify=False, manifest=False)
    d.update(kw)
    return argparse.Namespace(**d)


def _manifest_quickfix():
    """Hitra sanacija po manifestu: poškodovano/izginilo odstrani, da ga setup prinese nazaj."""
    if not MANIFEST.exists():
        return False
    try:
        files = json.loads(MANIFEST.read_text()).get("files", {})
    except (OSError, ValueError):
        return False
    fixed = False

    def broken(rel):
        if rel not in files:
            return False
        size, digest = files[rel]
        p = FORGE / rel
        if not p.exists():
            return True
        try:
            return p.stat().st_size != size or _sha256(p) != digest
        except OSError:
            return True

    for rel in ("engine/tools/winetricks", "engine/tools/bin/cabextract",
                "share/templates/base-prefix.tar.zst"):
        if broken(rel):
            warn(f"poškodovano/izginilo: {rel} — obnavljam iz cache/ponovnega prenosa")
            (FORGE / rel).unlink(missing_ok=True)
            fixed = True
    if broken("engine/wine/bin/wine") and WINE.exists():
        warn("Wine binarija je poškodovana — ponovno razpakiram (engine/wine)")
        shutil.rmtree(WINE, ignore_errors=True)
        fixed = True
    if broken("engine/nvidia-libs/x64/nvcuda.dll") and NVLIBS.exists():
        warn("nvidia-libs so poškodovane — obnavljam")
        shutil.rmtree(NVLIBS, ignore_errors=True)
        fixed = True
    return fixed


def cmd_setup(args):
    """Samodejna priprava motorja: prenese manjkajoče dele + predlogo."""
    if getattr(args, "verify", False):
        return manifest_verify()
    if getattr(args, "manifest", False):
        return manifest_build()
    if args.check:
        st = setup_status()
        for k, v in st.items():
            log(f" {'✓' if v else '✗'} {k}")
        return 0 if all(st.values()) else 1
    offline = bool(getattr(args, "offline", False))
    step(f"WineForge setup — priprava motorja{' (offline)' if offline else ''}")
    for d in (PREFIXES, APPS, DATA, LOGS, TEMPLATES, DEPS,
              SHARE / "verbs", TOOLS, TOOLSBIN, NVLIBS):
        d.mkdir(parents=True, exist_ok=True)
    _manifest_quickfix()
    # 1) želimo EN prenos (engine + predloga) — samo kadar manjka kaj velikega
    if not getattr(args, "parts", False):
        _setup_bundle(offline=offline)
    # 2) ostalo posamično (iz cache-a share/deps, če je že kdaj preneseno)
    try:
        _setup_wine(offline)
        _setup_nvidialibs(offline)
        _setup_winetricks(offline)
        _setup_cabextract(offline)
    except RuntimeError as e:
        die(str(e))
    if not BASE_TEMPLATE.exists():
        if args.no_bake:
            warn("predloga prefixa ni zgrada (preskočeno z --no-bake)")
        elif offline:
            die("predloga manjka, brez povezave je ne morem zgraditi\n"
                f"  (ali prenesi paket {ENGINE_BUNDLE})")
        else:
            step("Gradim predlogo prefixa — prvi zagon (10–20 min, prenosi VC++/.NET/WebView2)")
            cmd_bake(argparse.Namespace(name=None, resume=True, keep_going=True,
                                        no_pack=False, with_dotnet=args.with_dotnet,
                                        compact=False))
    # preverjanje
    st = setup_status()
    log()
    for k, v in st.items():
        log(f" {'✓' if v else '✗'} {k:<14} {'da' if v else 'NE'}")
    log()
    left = setup_missing()
    if left:
        warn("manjka še: " + ", ".join(left))
        return 1
    if not MANIFEST.exists():
        manifest_build()
    step("Motor pripravljen.")
    log("  Ikona (klik):          ./bin/wineforge desktop")
    log("  Ikona v pladnju:       ./bin/wineforge tray")
    log("  GUI v terminalu:       ./bin/wineforge gui")
    log("  Preveri integriteto:   ./bin/wineforge setup --verify")
    if args.desktop:
        cmd_desktop(argparse.Namespace(name=None, menu_only=False))
    return 0


# ---------------------------------------------------- pladnjska ikona/posodoba --

def cmd_tray(args):
    """Ikona v sistemskem pladnju (yad): programi z enim klikom."""
    pidfile = DATA / "tray.pid"
    if getattr(args, "quit", False):
        try:
            os.kill(int(pidfile.read_text().strip()), signal.SIGTERM)
            log("Pladnjska ikona zaprta.")
        except (OSError, ValueError):
            pass
        pidfile.unlink(missing_ok=True)
        return 0
    missing = setup_missing()
    if missing:
        warn(f"Motor nepripravljen (manjka: {', '.join(missing)}) — "
             "najprej zaženi: wineforge setup")
        return 1
    if _dialog() is None:
        die("Za pladnj potreben yad/zenity (npr. sudo pacman -S yad)\n"
            "  brez njiju deluje: wineforge gui")
    rows = [f"Odpri WineForge (gui)|'{FORGE}/bin/wineforge' gui"]
    for a in app_list():
        nm = a.get("name") or "?"
        rows.append(f"Zaženi: {nm}|'{FORGE}/bin/wineforge' run '{nm}'")
    rows += ["────────|/bin/true",
             f"Diagnoza (doctor)|'{FORGE}/bin/wineforge' doctor",
             f"Zapri ikono (izhod)|'{FORGE}/bin/wineforge' tray --quit"]
    DATA.mkdir(parents=True, exist_ok=True)
    # zapusti morebitno staro ikono (orfan iz prejšnjega zagona)
    if pidfile.exists():
        try:
            os.kill(int(pidfile.read_text().strip()), signal.SIGTERM)
            log("Zapiram prejšnjo ikono v pladnju.")
        except (OSError, ValueError):
            pass
        pidfile.unlink(missing_ok=True)
    icon = install_icon()
    step("Vklapljam ikono v pladnju (zapreš jo z desnim klikom → Izhod)")
    p = subprocess.Popen([shutil.which("yad") or "yad", "--notification",
                          f"--image={icon}",
                          "--tooltip=WineForge — programi z enim klikom",
                          f"--menu={'\n'.join(rows)}",
                          f"--command='{FORGE}/bin/wineforge' gui"],
                         stdout=subprocess.DEVNULL,
                         # pladnjski način v Wayland KDE (XWayland) zahteva X11 način
                         env={**os.environ, "GDK_BACKEND": "x11"})
    pidfile.write_text(str(p.pid))

    def _sig_then_quit(_sig, _frm):
        try:
            p.terminate()
            p.wait(timeout=2)
        except Exception:
            p.kill()
        pidfile.unlink(missing_ok=True)
        raise SystemExit(143)

    signal.signal(signal.SIGTERM, _sig_then_quit)
    signal.signal(signal.SIGINT, _sig_then_quit)
    try:
        p.wait()
    finally:
        pidfile.unlink(missing_ok=True)
    return 0


def cmd_update(args):
    """Posodobi kodo (git pull) in motor po potrebi."""
    step(f"WineForge update ({VERSION})")
    if (FORGE / ".git").is_dir() and not getattr(args, "no_pull", False):
        code, out = run(["git", "-C", str(FORGE), "pull", "--ff-only"], capture=True)
        if out.strip():
            log(out.strip()[-1000:])
        if code:
            warn("git pull ni uspel (lokalne spremembe?) — nadaljujem s tem, kar imam")
    if setup_missing():
        ensure_ready()
    log()
    log(f"  različica    {VERSION}  |  Wine {WINE_VER}")
    log(f"  predloga     {human(BASE_TEMPLATE.stat().st_size) if BASE_TEMPLATE.exists() else 'ni'}")
    log(f"  motor        {human(du(ENGINE)) if ENGINE.exists() else 'ni'}")
    log(f"  programi     {len(app_list())}  |  prefixi {len(list_prefixes())}")
    log(f"  manifest     {'da' if MANIFEST.exists() else 'NE (nastavi: wineforge setup --manifest)'}")
    log()
    step("Posodobljeno.")
    return 0


# ------------------------------------------------------------ ikone/.desktop --

def install_icon():
    """Kopira ikono v ikonsko temo in vrne pot do nje (za Icon= v .desktop)."""
    dst_dir = Path.home() / ".local/share/icons/hicolor/scalable/apps"
    dst_dir.mkdir(parents=True, exist_ok=True)
    dst = dst_dir / f"{ICON_NAME}.svg"
    if ICON_SRC.exists():
        try:
            shutil.copy2(ICON_SRC, dst)
        except OSError:
            pass
    return str(dst if dst.exists() else ICON_SRC)


def _desktop_dir():
    """Namizje uporabnika (tudi lokalizirano: ~/Desktop, ~/Namizje, ...)."""
    cfg = Path.home() / ".config/user-dirs.dirs"
    try:
        for line in cfg.read_text().splitlines():
            if line.startswith("XDG_DESKTOP_DIR="):
                val = line.split("=", 1)[1].strip().strip('"')
                val = val.replace("$HOME", str(Path.home()))
                p = Path(val)
                p.mkdir(parents=True, exist_ok=True)
                return p
    except OSError:
        pass
    for cand in ("Desktop", "Namizje", "Skriralnice"):
        p = Path.home() / cand
        if p.is_dir():
            return p
    p = Path.home() / "Desktop"
    p.mkdir(parents=True, exist_ok=True)
    return p


def _desktop_write(name=None, places=("menu", "desktop"), icon=None):
    """Zapiše .desktop vnos; vrne seznam ustvarjenih datotek."""
    icon = icon or install_icon()
    if name:
        meta = app_load(name)
        if not meta:
            die(f"Neznana aplikacija: {name}")
        fname = f"wineforge-{slugify(name)}.desktop"
        exec_line = f'"{FORGE}/bin/wineforge" run {name}'
        label = (meta.get("name") or name) + " (Wine)"
        comment = "Windows program prek WineForge"
        cats = "Wine;"
    else:
        fname = "wineforge.desktop"
        exec_line = f'"{FORGE}/bin/wineforge" gui'
        label = "WineForge"
        comment = "Prenosni Wine motor — dodaj, namesti in zaženi Windows programe"
        cats = "Utility;Development;Wine;"
    text = f"""[Desktop Entry]
Version=1.0
Type=Application
Name={label}
Comment={comment}
Exec={exec_line}
Icon={icon}
Terminal=false
Categories={cats}
StartupNotify=true
"""
    made = []
    if "menu" in places:
        menu = Path.home() / ".local/share/applications"
        menu.mkdir(parents=True, exist_ok=True)
        p = menu / fname
        p.write_text(text)
        p.chmod(0o755)
        made.append(p)
    if "desktop" in places:
        dd = _desktop_dir()
        p = dd / fname
        p.write_text(text)
        p.chmod(0o755)
        made.append(p)
    return made


def cmd_desktop(args):
    """Ustvari ikono v meniju in na namizju — potem samo klikneš."""
    places = ["menu"] + ([] if args.menu_only else ["desktop"])
    made = _desktop_write(args.name, places=tuple(places))
    for p in made:
        log(f"Ikona: {p}")
    if not args.menu_only and any("desktop" in str(p) for p in made):
        log("(v KDE bo morda prvič vprašal, ali zaupas datoteki — potrdi)")
    log("Klik na ikono odpre GUI; prvi zagon sam prenese, če česa manjka.")
    return 0


# ------------------------ simulacija pravic in windows storitev ("lažni") ----
# Nekateri programi (StarDesk, orodja za overlay, protipetje ...) zahtevajo
# skrbniške pravice in zagnano windows storitev. Wine nima UAC, ima pa pravi
# SCM (upravitelj windows storitev): `sc create` dela, njegovi services.exe pa
# registrirane storitve tudi sam zažene. WineForge to izkoristi: storitev
# registrira v prefixu, jo po potrebi zažene sam in napiše v register, da
# program vidi "skrbnik sem, UAC ne vpraša". Jedrskih gonilnikov to NE more
# nadomestiti.

SERVICES_KEY = r"HKLM\System\CurrentControlSet\Services"
POLICY_KEY = r"HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
ADMIN_VALUES = {"EnableLUA": "0", "ConsentPromptBehaviorAdmin": "0",
                "ConsentPromptBehaviorUser": "0", "PromptOnSecureDesktop": "0"}


def svc_key(name):
    return f"{SERVICES_KEY}\\{name}"


def reg_get(prefix, key, name):
    """Vrednost registrske vrednosti kot niz (ali None)."""
    code, out = wine(["reg", "query", key, "/v", name], prefix=prefix, capture=True)
    if code != 0:
        return None
    for line in (out or "").splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1].startswith("REG_") and parts[0].lower() == name.lower():
            return " ".join(parts[3:]) if len(parts) > 3 else parts[-1]
    return None


def svc_list(prefix):
    """Imena storitev, registriranih v SCM-ju prefixa."""
    code, out = wine(["reg", "query", SERVICES_KEY], prefix=prefix, capture=True)
    names = []
    for line in (out or "").splitlines():
        line = line.strip()
        if line.upper().startswith(SERVICES_KEY.upper() + "\\"):
            names.append(line.split("\\")[-1])
    return sorted(set(names))


def svc_info(prefix, name):
    """Vrednosti ključa storitve kot slovar (ali None, če storitve ni)."""
    code, out = wine(["reg", "query", svc_key(name), "/s"], prefix=prefix, capture=True)
    if code != 0:
        return None
    info = {}
    for line in (out or "").splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[1].startswith("REG_"):
            info[parts[0]] = " ".join(parts[3:]) or parts[2]
    return info or None


def svc_add(prefix, name, exe_win, auto=True):
    """Registrira windows storitev v prefixu (enako kot `sc create`)."""
    ok = True
    ok &= reg_add(prefix, svc_key(name), "ImagePath", exe_win, "REG_EXPAND_SZ")
    ok &= reg_add(prefix, svc_key(name), "Type", "16", "REG_DWORD")       # WIN32_OWN_PROCESS
    ok &= reg_add(prefix, svc_key(name), "Start", "2" if auto else "3", "REG_DWORD")
    ok &= reg_add(prefix, svc_key(name), "ErrorControl", "1", "REG_DWORD")
    ok &= reg_add(prefix, svc_key(name), "ObjectName", "LocalSystem")
    return bool(ok)


def svc_remove(prefix, name):
    wine(["reg", "delete", svc_key(name), "/f"], prefix=prefix, capture=True)


def svc_state(prefix, name):
    """(številka, beseda) iz `sc query`: 4 RUNNING, 1 STOPPED, (None,None) = ni registriran."""
    code, out = wine(["sc", "query", name], prefix=prefix, capture=True)
    for line in (out or "").splitlines():
        if "STATE" not in line:
            continue
        for num, word in (("4", "RUNNING"), ("1", "STOPPED"), ("2", "START_PENDING"),
                          ("3", "STOP_PENDING")):
            if re.search(rf"\b{num}\s+{word}", line):
                return num, word
    return None, None


def proc_pids(needle, prefix=None):
    """Pid-i zagnanih procesov po imenu binarke (lastni procesi, po želji v našem prefixu)."""
    base = re.split(r"[\\/]", str(needle))[-1].lower()   # windows poti Linux ne razume
    if base.endswith(".exe"):
        base = base[:-4]
    base = base[:14]
    want = ("WINEPREFIX=" + str(prefix)).encode() if prefix else None
    out = []
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            comm = (d / "comm").read_text().strip().lower()
            if base and not comm.startswith(base):
                continue
            if want and want not in (d / "environ").read_bytes().split(b"\0"):
                continue
        except OSError:
            continue
        out.append(int(d.name))
    return out


def svc_spawn(prefix, name, exe_win, args=None):
    """Zažene storitev kot navaden proces — simulacija SCM zagona."""
    LOGS.mkdir(parents=True, exist_ok=True)
    f = open(LOGS / f"storitev-{slugify(name)}.log", "a")
    env = wine_env(prefix, {"WINEDEBUG": "-all"})
    env["WINEFORGE_SVC"] = name
    subprocess.Popen([str(WINE), exe_win] + list(args or []), env=env,
                     stdout=f, stderr=subprocess.STDOUT, start_new_session=True)


def svc_stop(prefix, name, exe_win=None):
    for pid in proc_pids(exe_win or name, prefix):
        try:
            os.kill(pid, 15)
        except OSError:
            pass
    wine(["sc", "stop", name], prefix=prefix, capture=True)


def svc_ensure(prefix, name, exe_win, auto=True, wait=8, args=None):
    """Poskrbi, da storitev obstaja v SCM in da ji proces tece."""
    if not svc_info(prefix, name):
        svc_add(prefix, name, exe_win, auto)
        log(f"    storitev '{name}' registrirana v SCM ({exe_win})")
    num, word = svc_state(prefix, name)
    if word == "RUNNING" or proc_pids(exe_win, prefix):
        return True
    # services.exe jih zažene le ob zagonu wineservera in zna le tiste, ki se
    # javijo SCM-ju — če ne, zažene proces sam
    svc_spawn(prefix, name, exe_win, args)
    for _ in range(wait):
        time.sleep(1)
        if proc_pids(exe_win, prefix):
            log(f"    storitev '{name}' teče (simulirano)")
            return True
    warn(f"    storitve '{name}' ni bilo mogoče zagnati")
    return False


SVC_NAME_HINT = re.compile(r"(service|daemon|_svc|srv)", re.I)
SVC_SKIP_PATHS = ("edgecore", "microsoft\\edge", "windowsapps", "microsoft shared",
                  "dotnet", "microsoft.net\\framework")
SVC_SKIP_NAMES = ("psexec", "cmd", "powershell", "rundll", "mshta", "regsvr32",
                  "installutil", "js",
                  "cscript", "wscript")


def svc_candidates(prefix, limit=8, max_files=400):
    """Binarke v prefixu, ki se javijo SCM-ju (prave windows storitve).

    Vrne seznam z `likely=True` za tiste, ki jih je smiselno samodejno
    registrirati (ime se glasi kot storitev), in `likely=False` za sumljive.
    """
    markers = (b"StartServiceCtrlDispatcherW", b"RegisterServiceCtrlHandlerW",
               b"RegisterServiceCtrlHandlerExW")
    dc = prefix / "drive_c"
    seen = 0
    cands = []
    for root in ("Program Files", "Program Files (x86)"):
        base = dc / root
        if not base.is_dir():
            continue
        for f in sorted(base.rglob("*.exe")):
            if len(f.relative_to(base).parts) > 4:
                continue
            n = f.name.lower()
            if any(k in n for k in ("uninstall", "deinstall", "crashpad", "crashreport",
                                    "reporter", "updater", "setup")):
                continue
            if any(k in str(f).lower() for k in SVC_SKIP_PATHS):
                continue
            if any(k == n.split(".")[0] for k in SVC_SKIP_NAMES):
                continue
            cands.append(f)
    # napisi "...service.exe" so najverjetnejši — najprej na vrsto
    cands.sort(key=lambda f: ("service" not in f.name.lower(), len(str(f))))
    found, by_name = [], {}
    for f in cands:
        if len(by_name) >= limit or seen >= max_files:
            break
        seen += 1
        try:
            if f.stat().st_size > 120 * 1024 * 1024:
                continue
            data = f.read_bytes()
        except OSError:
            continue
        if not any(m in data for m in markers):
            continue
        name = f.stem
        if name in by_name:      # isti program je v dveh mapah
            continue
        rel = f.relative_to(dc)
        item = {"name": name, "exe": "C:\\" + str(rel).replace("/", "\\"),
                "likely": bool(SVC_NAME_HINT.search(name))}
        by_name[name] = item
        found.append(item)
    return found


def admin_sim(prefix, on=True):
    """V register napiše, da program vidi: skrbnik sem, UAC naj ne vpraša."""
    if on:
        for k, v in ADMIN_VALUES.items():
            reg_add(prefix, POLICY_KEY, k, v, "REG_DWORD")
        return True
    for k in ADMIN_VALUES:
        reg_delete(prefix, POLICY_KEY, k)
    return True


def admin_state(prefix):
    v = reg_get(prefix, POLICY_KEY, "EnableLUA")
    if v is None:
        return False
    try:
        return int(v, 0) == 0
    except ValueError:
        return False


def sim_status(prefix, svcs):
    lines = []
    lines.append("  pravice: " + ("lažno povišanje nastavljeno (UAC izklopljen v registru)"
                                  if admin_state(prefix) else
                                  "privzete (Wine-ov uporabnik je skrbnik)"))
    for s in svcs:
        num, word = svc_state(prefix, s["name"])
        pids = proc_pids(s["exe"], prefix)
        stanje = word or "ni registrirana"
        if pids and word != "RUNNING":
            stanje = "RUNNING (simulirano)"
        lines.append(f"  storitev {s['name']}: {stanje}"
                     + (f", pid {' '.join(map(str, pids))}" if pids else "")
                     + ("" if s.get("auto", True) else " [ročni zagon]"))
    return "\n".join(lines)

# ------ pogled programa (kaj vidi program) + identiteta/stroj "lažnega" ------

# C# sonda: prenese se in prenese v prefixu (rabí .NET Framework csc.exe, ki je
# v predlogi). Pokaze TO, kar program vidi: ali je skrbnik, katere pravice ima
# žeton, kako so videne storitve, kakšen stroj je napisan v registru.
PROBE_CS = r'''
using System;
using System.Text;
using System.Runtime.InteropServices;
using System.Security.Principal;
using System.ServiceProcess;
using Microsoft.Win32;

class Probe {
    [StructLayout(LayoutKind.Sequential)] struct LUID { public uint Low; public int High; }
    [DllImport("advapi32.dll", SetLastError = true)]
    static extern bool OpenProcessToken(IntPtr h, uint access, out IntPtr tok);
    [DllImport("advapi32.dll", SetLastError = true)]
    static extern bool GetTokenInformation(IntPtr tok, int cls, IntPtr buf, int len, out int ret);
    [DllImport("advapi32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    static extern bool LookupPrivilegeName(string host, ref LUID luid, StringBuilder name, ref int len);
    [DllImport("advapi32.dll", SetLastError = true)]
    static extern bool AdjustTokenPrivileges(IntPtr tok, bool disableAll, IntPtr st, int n, IntPtr prev, int[] ret);
    [DllImport("advapi32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    static extern bool LookupPrivilegeValue(string host, string name, out LUID luid);
    [DllImport("kernel32.dll")] static extern IntPtr GetCurrentProcess();

    static void Main(string[] argv) {
        WindowsIdentity wi = WindowsIdentity.GetCurrent();
        Console.WriteLine("uporabnik: " + wi.Name);
        Console.WriteLine("skrbnik (IsInRole Administrator): " +
                          new WindowsPrincipal(wi).IsInRole(WindowsBuiltInRole.Administrator));
        Console.WriteLine("Windows: " + Environment.OSVersion + "  64bit=" + Environment.Is64BitProcess);
        Console.WriteLine("Naziv: " + Reg(@"SOFTWARE\Microsoft\Windows NT\CurrentVersion", "ProductName")
                          + " " + Reg(@"SOFTWARE\Microsoft\Windows NT\CurrentVersion", "DisplayVersion")
                          + " (build " + Reg(@"SOFTWARE\Microsoft\Windows NT\CurrentVersion", "CurrentBuild") + ")");
        Console.WriteLine("EnableLUA: " + Reg(@"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System", "EnableLUA"));
        Console.WriteLine("MachineGuid: " + Reg(@"SOFTWARE\Microsoft\Cryptography", "MachineGuid"));
        Console.WriteLine("HwProfileGuid: " + Reg(@"SYSTEM\CurrentControlSet\Control\IDConfigDB\Hardware Profiles\0001", "HwProfileGuid"));

        IntPtr tok;
        if (!OpenProcessToken(GetCurrentProcess(), 0x28, out tok)) {
            Console.WriteLine("žeton: OpenProcessToken napaka " + Marshal.GetLastWin32Error());
            return;
        }
        int ret;
        GetTokenInformation(tok, 3, IntPtr.Zero, 0, out ret);
        IntPtr buf = Marshal.AllocHGlobal(ret);
        int skupil = 0, vklopljenih = 0;
        if (GetTokenInformation(tok, 3, buf, ret, out ret)) {
            int count = Marshal.ReadInt32(buf);
            for (int i = 0; i < count; i++) {
                IntPtr e = IntPtr.Add(buf, 4 + i * 12);
                LUID luid = new LUID();
                luid.Low = (uint)Marshal.ReadInt32(e);
                luid.High = Marshal.ReadInt32(IntPtr.Add(e, 4));
                uint attr = (uint)Marshal.ReadInt32(IntPtr.Add(e, 8));
                int nlen = 256;
                StringBuilder sb = new StringBuilder(256);
                if (LookupPrivilegeName(null, ref luid, sb, ref nlen)) {
                    skupil++;
                    if ((attr & 2) != 0) vklopljenih++;
                }
            }
            Console.WriteLine("pravice v žetonu: " + skupil + " (vklopljenih " + vklopljenih + ")");
        }
        foreach (string priv in new string[] { "SeDebugPrivilege", "SeShutdownPrivilege",
                                               "SeLoadDriverPrivilege", "SeTcbPrivilege", "SeImpersonatePrivilege" }) {
            LUID l;
            if (!LookupPrivilegeValue(null, priv, out l)) {
                Console.WriteLine("  " + priv + ": NE OBSTJA");
                continue;
            }
            IntPtr st = Marshal.AllocHGlobal(16);
            Marshal.WriteInt32(st, 1);
            Marshal.WriteInt32(st, 4, (int)l.Low);
            Marshal.WriteInt32(st, 8, l.High);
            Marshal.WriteInt32(st, 12, 2);
            int[] rl = new int[1];
            bool ok = AdjustTokenPrivileges(tok, false, st, 0, IntPtr.Zero, rl);
            int err = Marshal.GetLastWin32Error();
            Console.WriteLine("  " + priv + ": " + ((ok && err == 0) ? "VKLOP USPEL" : "napaka " + err));
            Marshal.FreeHGlobal(st);
        }
        if (argv.Length > 0) {
            Console.WriteLine("storitve, kot jih vidi program:");
            foreach (string s in argv) {
                try {
                    ServiceController sc = new ServiceController(s);
                    sc.Refresh();
                    Console.WriteLine("  " + s + ": " + sc.Status);
                } catch (Exception e) {
                    Console.WriteLine("  " + s + ": " + e.GetType().Name);
                }
            }
        }
    }

    static string Reg(string key, string val) {
        try {
            object o = Registry.LocalMachine.OpenSubKey(key).GetValue(val);
            return o == null ? "(nic)" : o.ToString();
        } catch (Exception) { return "(ni kljuca)"; }
    }
}
'''

NTV = r"HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion"

# Windows "maska": nekateri programi (in igre) zavrnejo zagon, ce ne vidijo
# dovolj novega Windowsa. Wine poroca verzijo iz registra, zato to deluje.
WIN_PROFILES = {
    "10": {"ProductName": "Windows 10 Pro", "CurrentBuild": "19045", "CurrentBuildNumber": "19045",
           "DisplayVersion": "22H2", "ReleaseID": "22H2", "UBR": "5011",
           "Major": "10", "Minor": "0"},
    "11": {"ProductName": "Windows 11 Pro", "CurrentBuild": "22631", "CurrentBuildNumber": "22631",
           "DisplayVersion": "23H2", "ReleaseID": "23H2", "UBR": "4317",
           "Major": "10", "Minor": "0"},
}


def win_apply(prefix, which):
    """Napise Windows masko (verzija/izdaja) v register prefixa."""
    prof = WIN_PROFILES.get(str(which))
    if not prof:
        return False
    reg_add(prefix, NTV, "ProductName", prof["ProductName"])
    reg_add(prefix, NTV, "CurrentBuild", prof["CurrentBuild"])
    reg_add(prefix, NTV, "CurrentBuildNumber", prof["CurrentBuildNumber"])
    reg_add(prefix, NTV, "DisplayVersion", prof["DisplayVersion"])
    reg_add(prefix, NTV, "ReleaseID", prof["ReleaseID"])
    reg_add(prefix, NTV, "CurrentMajorVersionNumber", prof["Major"], "REG_DWORD")
    reg_add(prefix, NTV, "CurrentMinorVersionNumber", prof["Minor"], "REG_DWORD")
    reg_add(prefix, NTV, "UBR", prof["UBR"], "REG_DWORD")
    reg_add(prefix, NTV, "BuildLab", prof["CurrentBuild"] + ".1")
    reg_add(prefix, NTV, "Path", r"%SystemRoot%\\Windows")
    return True


def identity(prefix):
    """Trenutna identiteta 'stroj' (za fingerprint preverbe programov)."""
    return {
        "ComputerName": reg_get(prefix, r"HKLM\SYSTEM\CurrentControlSet\Control\ComputerName\ComputerName", "ComputerName"),
        "MachineGuid": reg_get(prefix, r"HKLM\SOFTWARE\Microsoft\Cryptography", "MachineGuid"),
        "HwProfileGuid": reg_get(prefix, r"HKLM\SYSTEM\CurrentControlSet\Control\IDConfigDB\Hardware Profiles\0001", "HwProfileGuid"),
        "ProductName": reg_get(prefix, NTV, "ProductName"),
        "Build": reg_get(prefix, NTV, "CurrentBuild"),
        "InstallDate": reg_get(prefix, NTV, "InstallDate"),
    }


def identity_pin(prefix):
    """Ustvari/manjka manjkajoce identifikatorje, da se stroj ne spreminja."""
    made = []
    if not identity(prefix)["MachineGuid"]:
        reg_add(prefix, r"HKLM\SOFTWARE\Microsoft\Cryptography", "MachineGuid", str(uuid.uuid4()))
        made.append("MachineGuid")
    if not identity(prefix)["HwProfileGuid"]:
        reg_add(prefix, r"HKLM\SYSTEM\CurrentControlSet\Control\IDConfigDB\Hardware Profiles\0001",
                "HwProfileGuid", "{" + str(uuid.uuid4()).upper() + "}")
        made.append("HwProfileGuid")
    if not identity(prefix)["InstallDate"]:
        reg_add(prefix, NTV, "InstallDate", str(int(time.time())), "REG_DWORD")
        made.append("InstallDate")
    return made


def probe_exe(prefix):
    """Prevede sondo v prefixu (ali vrne že prevedeno)."""
    csc_win = None
    for rel in (r"C:\windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe",
                r"C:\windows\Microsoft.NET\Framework\v4.0.30319\csc.exe"):
        if (prefix / "drive_c" / rel[3:].replace("\\", "/")).exists():
            csc_win = rel
            break
    if not csc_win:
        return None
    src = DEPS / "probe"
    src.mkdir(parents=True, exist_ok=True)
    cs = src / "probe.cs"
    cs.write_text(PROBE_CS)
    out = src / ("probe-" + hashlib.sha1(str(prefix).encode()).hexdigest()[:8] + ".exe")
    if out.exists():
        return wine_path(out)
    code, _ = wine([csc_win, "/nologo", "/reference:System.ServiceProcess.dll",
                    "/out:" + wine_path(out), wine_path(cs)], prefix=prefix, capture=True)
    return wine_path(out) if code == 0 and out.exists() else None


def probe_run(prefix, svc_names=()):
    """Pokaze, kaj program vidi (pravice, storitve, stroj)."""
    exe = probe_exe(prefix)
    if not exe:
        return None
    code, out = wine([exe] + list(svc_names), prefix=prefix, capture=True)
    vr = []
    for line in (out or "").splitlines():
        if ":" in line and not re.match(r"^[0-9a-f]{4}:", line):
            vr.append(line.strip())
    return "\n".join(vr)


# ------ kaj je za Wine neemulabilno: jedrski gonilniki v namestitvi ---------

# (znamenje v imenu datoteke, kaj je, kaj je ustrezen pod Linuxom)
DRIVER_HINTS = (
    (("vigembus",), "ViGEmBus — navidezni gamepadi (Xbox/DS)",
     "/dev/uinput (Sunshine, AntiMicroX, python-evdev)"),
    (("sdvhid", "vhid"), "navidezni HID (tipkovnica / mis / pad)",
     "/dev/uinput"),
    (("idd",), "IddCx — navidezni zaslon",
     "vkms (Wayland/X11) ali navaden zaslon"),
    (("usbpcap", "usbip"), "USB/IP preusmeritev USB naprav",
     "jedrski usbip (pacman -S usbip) ali usbipd"),
    (("easyanticheat", "eac"), "Easy Anti-Cheat (jedrni)",
     "ni ustreznika — igra pod Linuxom ne teče"),
    (("battleye", "bedl"), "BattlEye (jedrni)", "ni ustreznika"),
    (("vgk", "vanguard"), "Riot Vanguard (jedrni)", "ni ustreznika"),
    (("faceit",), "FACEIT AC (jedrni)", "ni ustreznika"),
    (("sptd", "securom", "safedisc"), "stara zaščita pred kopiranjem",
     "GOG/Steam ponatis ali originalni disk"),
    (("tap", "tun", "wintun"), "navidezno omrežje (VPN)", "Linux tun/tap (netplan, NetworkManager)"),
)


def drivers_scan(prefix, limit=14):
    """Najde jedrske gonilnike (.sys/.inf) v namestitvi in razlazi, kaj so."""
    found = []
    for f in sorted(prefix.glob("drive_c/Program Files*/**/*.sys")):
        base = f.name.lower()
        rel = str(f.relative_to(prefix))
        for marks, kaj, linux in DRIVER_HINTS:
            if any(mark in rel.lower() for mark in marks) or any(mark in base for mark in marks):
                found.append({"file": rel, "kaj": kaj, "linux": linux})
                break
        else:
            found.append({"file": rel, "kaj": "jedrski gonilnik (" + f.stem + ")",
                          "linux": "ni znanega ustreznika"})
        if len(found) >= limit:
            break
    return found


def cmd_sim(args):
    """Programu predstavi, da je dobil skrbniške pravice in da njegova storitev teče."""
    meta = app_load(args.name)
    if not meta:
        die(f"Aplikacija '{args.name}' ne obstaja. Uporabi: wineforge list")
    prefix = prefix_path(meta.get("prefix") or args.name)
    if not prefix.exists():
        prefix = prepare_app_prefix(args.name)
    svcs = list(meta.get("services", []))

    for spec in args.svc or []:
        svc_args = []
        if "|" in spec:
            spec, a = spec.split("|", 1)
            svc_args = a.split()
        if "=" in spec:
            name, exe = spec.split("=", 1)
        else:
            exe = spec
            name = re.split(r"[\\/]", spec)[-1]
            name = name[:-4] if name.lower().endswith(".exe") else name
        exe = exe.replace("/", "\\") if re.match(r"^[A-Za-z]:", exe) else wine_path(exe)
        svcs = [s for s in svcs if s["name"] != name]
        svcs.append({"name": name, "exe": exe, "auto": not args.manual, "args": svc_args})
        svc_add(prefix, name, exe, not args.manual)
        log(f"storitev '{name}' -> {exe} {' '.join(svc_args)}")

    for n in args.rm or []:
        svc_stop(prefix, n, next((s["exe"] for s in svcs if s["name"] == n), n))
        svc_remove(prefix, n)
        svcs = [s for s in svcs if s["name"] != n]
        log(f"storitev '{n}' odstranjena")

    if not svcs and not (args.svc or args.rm or args.status or args.stop):
        kandi = svc_candidates(prefix)
        if kandi:
            log("Najdene programske storitve:")
            for k in kandi:
                if not k["likely"]:
                    log(f"    morda {k['name']}  ({k['exe']}) — ce hoces: --svc \"{k['name']}={k['exe']}\"")
                    continue
                log(f"    {k['name']}  ({k['exe']})")
                svc_add(prefix, k["name"], k["exe"], True)
                svcs.append({"name": k["name"], "exe": k["exe"], "auto": True, "args": []})
        else:
            log("V prefixu ni bilo najdene programske storitve "
                "(dodaj ročno: wineforge sim " + args.name + ' --svc "IME=C:\\pot\\x.exe")')

    if args.win and not win_apply(prefix, args.win):
        warn(f"Neznan profil Windowsa '{args.win}' (poznam: " + ", ".join(WIN_PROFILES) + ")")
    if args.pin:
        created = identity_pin(prefix)
        log("Identiteta stroja: " + ("dodano " + ", ".join(created) if created
                                     else "že celovita (MachineGuid, HwProfileGuid, InstallDate)"))

    env = dict(meta.get("env") or {})
    if args.admin:
        admin_sim(prefix, True)
        # za Wine gradnje, ki to podpirajo (nas 11.22 ignorira — ni skodov shimov)
        env["__COMPAT_LAYER"] = "RunAsInvoker"
        log("lažno povišanje vklopljeno")
    if args.no_admin:
        admin_sim(prefix, False)
        env.pop("__COMPAT_LAYER", None)
        log("lažno povišanje izklopljeno")
    if env:
        meta["env"] = env

    meta["services"] = svcs
    app_save(meta)

    if svcs and not args.stop and not args.status:
        log("Zagotavljam storitve:")
        for s in svcs:
            svc_ensure(prefix, s["name"], s["exe"], s.get("auto", True), args=s.get("args"))
    if args.stop:
        for s in svcs:
            svc_stop(prefix, s["name"], s["exe"])
        log("storitve ustavljene")
    if args.verify or args.status:
        ident = identity(prefix)
        print("  stroj: " + f"{ident['ProductName']} build {ident['Build']}, "
              f"ComputerName={ident['ComputerName']}, MachineGuid={str(ident['MachineGuid'])[:13]}…")
    if args.verify:
        izp = probe_run(prefix, [s["name"] for s in svcs])
        if izp is None:
            warn("sonde ni bilo mogoče prevesti (v prefixu ni .NET Framework csc.exe) — "
                 "pokliči: wineforge prefix tweaks ali winetricks dotnet48")
        else:
            print("\nKaj program vidi (sonda v prefixu):")
            for line in izp.splitlines():
                print("  " + line)
    else:
        print(sim_status(prefix, svcs))
    gon = drivers_scan(prefix)
    if gon:
        print("\nJedrski gonilniki v namestitvi (tega Wine NE more emulirati):")
        for g in gon:
            print(f"  {g['file']}\n      je: {g['kaj']}\n      pod Linuxom: {g['linux']}")
        warn("Uporabniški del (pravice, storitve, register, žeton) je izenačen; ti\n"
             "gonilniki gredo v jedro Windows in jih Wine ne more ponarediti —\n"
             "če je v njih srž programa, je prava pot linuxni ustreznik.")
    return 0


# ---------------------------------------------- navidezni gamepad (uinput) ----
# Windows igre ne berejo tipk iz X11, ampak XInput/DirectInput, ki pod Wineom
# prideta iz jedrnih vhodnih naprav (/dev/input). Tu torej NE posnemamo gumba:
# naredimo pravo napravo v Linuxovem jedru (/dev/uinput, brez roota) in Wine jo
# pokaže kot "Controller (XBox 360 for Windows)". To je linuxni ustreznik
# windowskim gonilnikom tipa ViGEmBus — brez windowskega kernela in brez VM.

UINPUT_DEV = "/dev/uinput"
PAD_NAME = "WineForge Virtual Pad"
PAD_SOCK = DATA / "pad.sock"
PAD_PID = DATA / "pad.pid"

UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT = 0x40045564, 0x40045565, 0x40045567
UI_DEV_SETUP, UI_ABS_SETUP = 0x405C5503, 0x401C5504
EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03

PAD_BTN = {"a": 0x130, "b": 0x131, "x": 0x133, "y": 0x134, "lb": 0x135, "rb": 0x136,
           "lt": 0x137, "rt": 0x138, "back": 0x139, "select": 0x139, "start": 0x13B,
           "guide": 0x13C, "lstick": 0x13D, "rstick": 0x13E}
PAD_ABS = {"lx": (0x00, -32768, 32767), "ly": (0x01, -32768, 32767),
           "rx": (0x03, -32768, 32767), "ry": (0x04, -32768, 32767),
           "lt": (0x02, 0, 255), "rt": (0x05, 0, 255),
           "dpadx": (0x10, -1, 1), "dpady": (0x11, -1, 1)}
PAD_DPAD = {"desno": (1, 0), "levo": (-1, 0), "gor": (0, -1), "dol": (0, 1),
            "none": (0, 0)}


class VirtualPad:
    """Prava vhodna naprava v jedru (Xbox 360 layout) prek /dev/uinput."""

    def __init__(self, name=PAD_NAME):
        import fcntl
        self.fcntl = fcntl
        self.name = name
        self.fd = os.open(UINPUT_DEV, os.O_WRONLY | os.O_NONBLOCK)

    def create(self):
        for ev, klici in ((EV_KEY, sorted(set(PAD_BTN.values()))),
                          (EV_ABS, sorted(set(c for c, _, _ in PAD_ABS.values())))):
            fcntl = self.fcntl
            fcntl.ioctl(self.fd, UI_SET_EVBIT, ev)
            for k in klici:
                fcntl.ioctl(self.fd, UI_SET_KEYBIT if ev == EV_KEY else UI_SET_ABSBIT, k)
        fcntl.ioctl(self.fd, UI_DEV_SETUP,
                    struct.pack("HHHH80sI", 0x03, 0x045E, 0x028E, 0x0110,
                                self.name.encode(), 0))
        for _, (code, mn, mx) in sorted(PAD_ABS.items()):
            fcntl.ioctl(self.fd, UI_ABS_SETUP, struct.pack("HHiiiiii", code, 0, 0, mn, mx, 0, 0, 0))
        fcntl.ioctl(self.fd, UI_DEV_CREATE)
        time.sleep(0.8)

    def _ev(self, typ, code, value):
        ns = time.time_ns()
        tv = struct.pack("qq", ns // 1_000_000_000, (ns % 1_000_000_000) * 1000)
        os.write(self.fd, tv + struct.pack("HHi", typ, code, value))

    def key(self, button, down):
        self._ev(EV_KEY, PAD_BTN[button.lower()], 1 if down else 0)
        self._ev(EV_SYN, 0, 0)

    def tap(self, button, hold=0.2):
        self.key(button, True)
        time.sleep(hold)
        self.key(button, False)

    def axis(self, name, value):
        code, mn, mx = PAD_ABS[name.lower()]
        if name.lower() in ("lt", "rt"):
            v = int(max(0.0, min(1.0, float(value))) * 255)
        elif name.lower().startswith("dpad"):
            v = max(-1, min(1, int(float(value))))
        else:
            v = int(max(-1.0, min(1.0, float(value))) * 32767)
            if name.lower() in ("ly", "ry"):
                v = -v          # Linux ima Y obrnjen glede na XInput
        self._ev(EV_ABS, code, v)
        self._ev(EV_SYN, 0, 0)

    def dpad(self, smer):
        x, y = PAD_DPAD[smer.lower()]
        self.axis("dpadx", x)
        self.axis("dpady", y)

    def close(self):
        try:
            self.fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except OSError:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass


def pad_kernel():
    """Je naša naprava že v jedru? vrne vozlišči (npr. 'event20 js0') ali None."""
    try:
        txt = Path("/proc/bus/input/devices").read_text()
    except OSError:
        return None
    for blok in txt.split("\n\n"):
        if PAD_NAME.lower() in blok.lower() or "wineforge" in blok.lower():
            handlers = ""
            for line in blok.splitlines():
                if line.startswith("H: Handlers="):
                    handlers = line.split("=", 1)[1].strip()
            return handlers
    return None


def pad_pids():
    if not PAD_PID.exists():
        return []
    try:
        pid = int(PAD_PID.read_text().strip())
    except ValueError:
        return []
    return [pid] if Path(f"/proc/{pid}").exists() else []


def pad_send(cmd):
    """Pošlje ukaz zagnanemu pad daemonu."""
    import socket
    if not PAD_SOCK.exists():
        return False, "pad ni zagnan (wineforge pad --start)"
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(6)
        s.connect(str(PAD_SOCK))
        s.sendall((cmd + "\n").encode())
        odg = s.recv(200).decode(errors="replace").strip()
        s.close()
        return True, odg
    except OSError as e:
        return False, str(e)


def pad_daemon(name=PAD_NAME):
    """Ostane živ in drži napravo; sprejema ukaze po UNIX vtičnici."""
    import socket
    if PAD_SOCK.exists():
        try:
            st = PAD_SOCK.stat()
            if st.st_uid != os.getuid():
                PAD_SOCK.unlink()
            else:
                pad_send("ping")
        except OSError:
            PAD_SOCK.unlink()
    pad = VirtualPad(name)
    PAD_PID.write_text(str(os.getpid()))     # najprej pid, da starš ne dirka v prazno
    pad.create()
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(str(PAD_SOCK))
    os.chmod(PAD_SOCK, 0o600)
    srv.listen(4)
    zadnji = time.time()
    while True:
        srv.settimeout(30)
        try:
            conn, _ = srv.accept()
        except socket.timeout:
            if not pad_pids_ok():
                break
            continue
        try:
            ukaz = conn.recv(200).decode(errors="replace").strip()
        except OSError:
            continue
        with contextlib.suppress(OSError):
            conn.sendall(b"ok\n")
        conn.close()
        zadnji = time.time()
        if ukaz == "quit":
            break
        deli = ukaz.split()
        try:
            if deli[0] == "press" and deli[1].lower() in PAD_BTN:
                pad.tap(deli[1], float(deli[2]) if len(deli) > 2 else 0.2)
            elif deli[0] == "down" and deli[1].lower() in PAD_BTN:
                pad.key(deli[1], True)
            elif deli[0] == "up" and deli[1].lower() in PAD_BTN:
                pad.key(deli[1], False)
            elif deli[0] == "axis" and deli[1].lower() in PAD_ABS:
                pad.axis(deli[1], float(deli[2]))
            elif deli[0] == "dpad" and deli[1].lower() in PAD_DPAD:
                pad.dpad(deli[1])
            elif deli[0] == "seq":
                # seq A:0.2:400,B:0.2:200  -> pritisni, drži, pavza (ms)
                for korak in ",".join(deli[1:]).split(","):
                    d = korak.split(":")
                    pad.tap(d[0], float(d[1]) if len(d) > 1 else 0.2)
                    time.sleep((float(d[2]) if len(d) > 2 else 300) / 1000.0)
        except (IndexError, ValueError):
            pass
    pad.close()
    with contextlib.suppress(OSError):
        PAD_SOCK.unlink()
        PAD_PID.unlink()
    return 0


def pad_pids_ok():
    """Daemon ugasne, če mu pid datoteka ne več ne pripada (npr. zunanje brisanje)."""
    if not PAD_PID.exists():
        return False
    try:
        return int(PAD_PID.read_text().strip()) == os.getpid()
    except ValueError:
        return False


def cmd_pad(args):
    """Navidezni Xbox gamepad za windowske igre pod Wine (brez roota)."""
    if args.daemon:
        return pad_daemon(args.name or PAD_NAME)
    zivi = bool(pad_pids())
    if args.start:
        if zivi:
            log("pad ze tece")
        else:
            LOGS.mkdir(parents=True, exist_ok=True)
            with open(LOGS / "pad.log", "a") as f:
                subprocess.Popen([sys.executable, str(FORGE / "bin" / "wineforge"), "pad", "--daemon"],
                                 stdout=f, stderr=subprocess.STDOUT, start_new_session=True,
                                 cwd=str(FORGE))
            for _ in range(20):
                time.sleep(0.5)
                if pad_kernel() and pad_pids():
                    break
        roko = pad_kernel()
        if roko:
            log(f"naprava v jedru: {PAD_NAME}  (vozlišči: {roko})")
            log("Wine jo pokaže kot »Controller (XBox 360 for Windows)«")
        else:
            die("naprave ni bilo mogoče ustvariti — preveri, da je modul uinput naložen "
                "in da je /dev/uinput zapisljiv")
        return 0
    if args.stop:
        ok, odg = pad_send("quit")
        for pid in pad_pids():
            with contextlib.suppress(OSError):
                os.kill(pid, 15)
        with contextlib.suppress(OSError):
            PAD_SOCK.unlink()
            PAD_PID.unlink()
        log("zaustavljeno")
        return 0
    if args.press:
        ok, odg = pad_send("press " + args.press + (f" {args.hold}" if args.hold else ""))
        print(("pritisnjen " + args.press) if ok else odg)
        return 0 if ok else 1
    if args.axis:
        ok, odg = pad_send("axis " + args.axis[0] + " " + args.axis[1])
        print(("os " + " ".join(args.axis)) if ok else odg)
        return 0 if ok else 1
    if args.dpad:
        ok, odg = pad_send("dpad " + args.dpad)
        print(("dpad " + args.dpad) if ok else odg)
        return 0 if ok else 1
    if args.seq:
        ok, odg = pad_send("seq " + args.seq)
        print("niz poslán" if ok else odg)
        return 0 if ok else 1
    if args.demo:
        for g in ("a", "b", "x", "y", "start"):
            pad_send(f"press {g}")
            time.sleep(0.35)
        for v in ("0.9", "-0.9", "0"):
            pad_send("axis lx " + v)
            time.sleep(0.25)
        log("demo poslán (preveri joy.cpl v Wineu)")
        return 0
    # privzeto: stanje
    log(f"uinput: {'obstaja' if Path(UINPUT_DEV).exists() else 'MANJKA (/dev/uinput)'}")
    roko = pad_kernel()
    log("naprava v jedru: " + (roko if roko else "ne"))
    log("daemon: " + ("tece (pid " + str(pad_pids()[0]) + ")" if pad_pids() else "ne tece"))
    log("uporaba: wineforge pad --start, nato --press a | --axis lx 0.9 | --dpad desno | --seq a,b:0.2:600")
    return 0


# ------------------------------------------------------------------- GUI ----

def _dialog():
    """zenity, yad (privzeto na KDE) ali kdialog."""
    if _DIALOG[0]:
        return _DIALOG[0]
    for cand in ("zenity", "yad", "kdialog"):
        if shutil.which(cand):
            _DIALOG[0] = cand
            return cand
    return None


def _zt_kdialog(argv, input=None):
    """Prevod zenity -> kdialog (kdialog ima popolnoma drugačno sintakso)."""
    def opt(name):
        return next((a.split("=", 1)[1] for a in argv if a.startswith(name + "=")), "")

    title = opt("--title") or "WineForge"
    text = opt("--text") or title
    if "--text-info" in argv:
        # kdialog nima --text-info: zapišemo v začasno datoteko -> --textbox
        w = opt("--width") or "760"
        h = opt("--height") or "520"
        tmp = Path(tempfile.gettempdir()) / f"wineforge-{os.getpid()}.txt"
        tmp.write_text(input or "", encoding="utf-8", errors="replace")
        try:
            run(["kdialog", "--title", title, "--textbox", str(tmp), w, h],
                capture=True)
        finally:
            tmp.unlink(missing_ok=True)
        return 0, ""
    if "--question" in argv:
        code, _out = run(["kdialog", "--title", title, "--yesno", text], capture=True)
        return (0 if code == 0 else 1, "")
    if "--info" in argv:
        run(["kdialog", "--title", title, "--msgbox", text], capture=True)
        return 0, ""
    if "--entry" in argv:
        init = next((a.split("=", 1)[1] for a in argv if a.startswith("--entry-text=")), "")
        _c, out = run(["kdialog", "--title", title, "--inputbox", text, init],
                      capture=True)
        return 0, out.strip()
    if "--password" in argv:
        _c, out = run(["kdialog", "--title", title, "--password", text], capture=True)
        return 0, out.strip()
    if "--file-selection" in argv:
        pats = [a.split("|", 1)[1].strip() for a in argv
                if a.startswith("--file-filter=") and "|" in a]
        cmd = ["kdialog", "--title", title, "--getopenfilename"]
        if pats:
            cmd.append(" ".join(pats))
        code, out = run(cmd, capture=True)
        return (code, out.strip())
    if "--list" in argv:
        ncols = sum(1 for a in argv if a.startswith("--column=")) or 1
        cells = [c for c in opt("--list").split("||") if c.strip()]
        if not cells:
            pos = [a for a in argv[1:] if not a.startswith("-")]
            cells = ["|".join(pos[i:i + ncols]) for i in range(0, len(pos), ncols)]
        if not cells:
            return 1, ""
        cmd = ["kdialog", "--title", title, "--menu", text]
        labels = []
        for i, c in enumerate(cells):
            label = c.split("|")[0]
            labels.append(label)
            cmd += [str(i), label]
        code, out = run(cmd, capture=True)
        if code:
            return 1, ""
        return 0, (out.strip() if not out.strip().isdigit()
                   else cells[int(out.strip())].split("|")[0])
    if input:
        run(["kdialog", "--title", title, "--msgbox", input], capture=True)
        return 0, ""
    run(["kdialog", "--title", title, "--msgbox", text], capture=True)
    return 0, ""


def zt(*args, input=None):
    """Zažene zenity/yad/kdialog in vrne (koda, stdout)."""
    tool = _dialog()
    if tool is None:
        die("Za grafični vmesnik potreben zenity ALI yad (npr. sudo pacman -S yad)")
    argv = list(args)
    if tool == "kdialog":
        return _zt_kdialog(argv, input=input)
    if tool == "yad":
        # zenity -> yad prevod (yad 15 nima --info/--question/--hide-header/...)
        kind = next((a for a in argv if a in ("--info", "--question")), None)
        text = None
        if kind:
            argv = [a for a in argv if not a.startswith("--text=")]
            text = next((a[7:] for a in args if a.startswith("--text=")), "")
            argv = ["--text-info" if a == kind else a for a in argv]
        fixed = []
        for a in argv:
            if a == "--hide-header":
                fixed.append("--no-headers")
            elif a == "--file-selection":
                # yad 15 nima --file-selection: način izbire datoteke je --file
                fixed.append("--file")
            elif a.startswith("--font="):                fixed.append("--fontname=" + a.split("=", 1)[1])
            elif a.startswith("--ok-label="):
                fixed.append("--button=" + a.split("=", 1)[1] + ":0")
            elif a.startswith("--cancel-label="):
                fixed.append("--button=" + a.split("=", 1)[1] + ":1")
            else:
                fixed.append(a)
        if kind and not any(a.startswith("--button=") for a in fixed):
            fixed += ["--button=OK:0"]
            if kind == "--question":
                fixed += ["--button=Cancel:1"]
        argv, inp = fixed, (text if text is not None else input)
    else:
        inp = input
        # zenity ne pozna --wrap/--tail (sam prelamlja); yad ju potrebuje
        argv = [a for a in argv if a not in ("--wrap", "--tail")]
    p = subprocess.run([tool, *argv], text=True, input=inp,
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                       env=os.environ.copy())
    return p.returncode, p.stdout or ""



def _wf(*args, progress_msg=None):
    """Požene wineforge kot podproces; med delom kaže napredek."""
    cmd = [sys.executable, str(FORGE / "bin" / "wineforge"), *args]
    prog = None
    dlg = _dialog() if progress_msg else None
    if progress_msg and dlg in ("zenity", "yad"):
        prog = subprocess.Popen([dlg, "--progress", "--pulsate", "--auto-close",
                                 "--width=420", "--title=WineForge",
                                 "--text=" + progress_msg],
                                stdin=subprocess.PIPE)
    p = subprocess.run(cmd, capture_output=True, text=True,
                       env={**os.environ, "WINEFORGE_DIR": str(FORGE)})
    if prog:
        try:
            prog.stdin.close()
            prog.wait(timeout=5)
        except Exception:
            prog.kill()
    out = re.sub(r"\x1b\[[0-9;]*m", "", (p.stdout or "") + (p.stderr or ""))
    return p.returncode, out


def _pick_file(title, patterns="*.exe"):
    code, out = zt("--file-selection", f"--title={title}",
                   f"--file-filter=Windows program | {patterns}",
                   "--file-filter=Vse datoteke | *")
    return out.strip() if code == 0 else None


def _ask(title, text, default=""):
    code, out = zt("--entry", f"--title={title}", f"--text={text}", f"--entry-text={default}")
    return out.strip() if code == 0 else None


def _show(title, text, width=760, height=520, log=None):
    """Okno z izpisom. --wrap = dolge vrstice se prelomijo (yad jih sicer odreže),
    --tail = prikaže se KONEC izpisa (tam so napake)."""
    args = ["--text-info", f"--title={title}", f"--width={width}",
            f"--height={height}", "--font=monospace", "--wrap"]
    nlines = text.count("\n")
    if nlines > 25:
        args.append("--tail")
    if log:
        args.append("--button=Odpri dnevnik:2")
    code, _out = zt(*args, input=text)
    if code == 2 and log:
        subprocess.Popen(["xdg-open", str(log)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return code


def _app_menu(title):
    metas = app_list()
    if not metas:
        zt("--info", "--title=WineForge", "--text=Najprej dodaj kak program.")
        return None
    rows = [(m.get("name") or "?", m.get("exe", "")) for m in metas]
    args = ["--list", f"--title={title}", "--column=Program", "--column=Exe",
            "--width=700", "--height=400", "--print-column=1"]
    for r in rows:
        args += list(r)
    code, out = zt(*args)
    return out.strip() if code == 0 else None


def cmd_gui(args):
    _dialog()  # zenity ali yad
    if setup_missing():
        # prvi zagon na novem računalniku: vse se prenese samodejno
        code, out = _wf("setup",
                        progress_msg="Prvi zagon — pripravljam motor.\n"
                                     "Prenos Wine in komponent, lahko traja ...")
        if setup_missing():
            die("Priprava motorja ni uspela:\n" + out[-800:])
    while True:
        code, choice = zt("--list", "--title=WineForge — prenosni Wine motor",
                          "--width=520", "--height=380", "--hide-header",
                          "--text=<b>Kaj želiš narediti?</b>",
                          "--column=Dejanje",
                          "Dodaj prenosni program (.exe v mapi)",
                          "Namesti program (installer .exe/.msi)",
                          "Zaženi program",
                          "Popravi program (belo okno / podatki)",
                          "Nastavi velikost vmesnika (DPI/zoom)",
                          "Naredi prenosni paket (USB)",
                          "Odpri mapo programov",
                          "Odpri dnevnike (napake pri namestitvi)",
                          "Namestuj igro s CD/DVD ali ISO slike",
                          "Dopolni predvajanje videa (igre z uvodnimi videi)",
                          "Program naj misli, da je skrbnik (pravice + storitve)",
                          "Navidezni gamepad (igre brez ročke)",
                          "Diagnoza (Wine, GPU, CUDA)",
                          "Zapri")
        if code != 0 or not choice.strip():
            return 0
        c = choice.strip()
        if c.startswith("Dodaj"):
            exe = _pick_file("Izberi program (.exe)")
            if not exe:
                continue
            name = _ask("Ime programa", "Ime za vnos v seznam:", Path(exe).stem.lower())
            if not name:
                continue
            code, out = _wf("add", name, "--exe", exe,
                            progress_msg=f"Dodajam {Path(exe).name} ...")
            _show("Dodajanje", out)
        elif c.startswith("Namesti"):
            inst = _pick_file("Izberi namestitveni program", "*.exe *.msi")
            if not inst:
                continue
            name = _ask("Ime programa", "Ime za vnos v seznam:",
                        re.sub(r"(?i)(setup|install|installer|x64|x86|_|-)", "",
                               Path(inst).stem).strip(" .") or "app")
            if not name:
                continue
            code, out = _wf("install", inst, "--name", name,
                            progress_msg=f"Nameščam {Path(inst).name} ...\nTo lahko traja nekaj minut.")
            m = re.search(r"dnevnik namestitve: (\S+)", out)
            log_path = m.group(1) if m else None
            _show("Namestitev — " + name, out, log=log_path)
        elif c.startswith("Zaženi"):
            name = _app_menu("Zaženi program")
            if name:
                env = {**os.environ, "WINEFORGE_DIR": str(FORGE)}
                subprocess.Popen([sys.executable, str(FORGE / "bin" / "wineforge"),
                                  "run", name], env=env,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                zt("--info", "--title=WineForge", "--timeout=3",
                   f"--text=Zaganjam <b>{name}</b> ...")
        elif c.startswith("Nastavi velikost"):
            name = _app_menu("Nastavi velikost vmesnika")
            if not name:
                continue
            code, pct = zt("--scale", "--title=Velikost vmesnika", "--value=150",
                           "--min-value=50", "--max-value=300", "--step=5",
                           "--text=Kako velik vmesnik? (100 = normalno, 150 = večje)")
            if code != 0:
                continue
            code2, out2 = _wf("scale", name, str(int(float(pct.strip() or 150))),
                              progress_msg="Nastavljam velikost ...")
            _show("Velikost vmesnika", out2)
        elif c.startswith("Popravi"):
            name = _app_menu("Popravi program")
            if not name:
                continue
            code, out = zt("--question", "--title=Popravi",
                           f"--text=Obnovim podatke iz varnostne kopije za <b>{name}</b>?\n"
                           "(Če ne veš, izberi Ne — ponastavi se samo WebView2.)",
                           "--ok-label=Obnovi podatke", "--cancel-label=Samo WebView2")
            code2, out2 = _wf("repair", name, *(["--restore"] if code == 0 else []),
                              progress_msg="Popravljam ...")
            _show("Popravilo", out2)
        elif c.startswith("Naredi"):
            name = _app_menu("Prenosni paket")
            if not name:
                continue
            code, folder = zt("--file-selection", "--directory",
                              "--title=Kam shranim paket?")
            if code != 0:
                continue
            code2, out2 = _wf("pack", name, "--out", folder.strip(), "--force",
                              progress_msg=f"Pakiram {name} ...")
            _show("Pakiranje", out2)
        elif c.startswith("Odpri mapo"):
            subprocess.Popen(["xdg-open", str(APPS)])
        elif c.startswith("Odpri dnevnike"):
            LOGS.mkdir(parents=True, exist_ok=True)
            subprocess.Popen(["xdg-open", str(LOGS)])
        elif c.startswith("Diagnoza"):
            code, out = _wf("doctor", progress_msg="Preverjam motor, GPU in CUDA ...")
            _show("Diagnoza", out)
        elif c.startswith("Namestuj igro s CD"):
            code, choice = zt("--list", "--title=Disk CD/DVD ali ISO", "--hide-header",
                              "--width=460", "--text=<b>Kje je igra?</b>",
                              "--column=Vir",
                              "Izberi ISO sliko (.iso)",
                              "Uporabi vstavljen disk (CD/DVD pogon)")
            if code != 0:
                continue
            disc_out = ""
            if choice.strip().startswith("Izberi ISO"):
                iso = _pick_file("Izberi ISO sliko igre", "*.iso *.ISO *.img *.mdf")
                if not iso:
                    continue
                code, disc_out = _wf("disc", "--iso", iso,
                                     progress_msg="Nalagam ISO sliko ...")
            else:
                code, disc_out = _wf("disc", progress_msg="Prepoznavam disk ...")
            _show("Disk", disc_out)
            if "namestitveni programi" not in disc_out:
                continue
            name = _ask("Ime igre", "Kako naj jo pišem v seznam?", "igra")
            if not name:
                continue
            code, out = _wf("disc", "--install", "--name", name,
                            progress_msg="Nameščam igro s diska ...\n"
                                         "Lahko traja nekaj minut.")
            m = re.search(r"dnevnik namestitve: (\S+)", out)
            _show("Namestitev z diska", out, log=m.group(1) if m else None)
        elif c.startswith("Program naj misli"):
            name = _app_menu("Skrbniške pravice in storitve")
            if not name:
                continue
            code, out = _wf("sim", name,
                            progress_msg=f"Urejam pravice in storitve za {name} ...")
            _show("Pravice in storitve — " + name, out)
        elif c.startswith("Navidezni gamepad"):
            if pad_pids():
                _wf("pad", "--stop")
                _show("Gamepad", "Izklopljen. Igre ga ne vidijo več.")
            else:
                code, out = _wf("pad", "--start",
                                progress_msg="Ustvarjam navidezni gamepad ...")
                _show("Gamepad", out +
                      "\nIgre ga vidijo kot »Controller (XBox 360 for Windows)«.\n"
                      "Vnosi: bin/wineforge pad --press a | --axis lx 0.9 | --dpad desno")
        elif c.startswith("Dopolni predvajanje"):
            code, out = _wf("media", "--fix",
                            progress_msg="Dopolnjujem predvajanje videa ...")
            _show("Predvajanje videa", out)
        else:
            return 0


def cmd_shortcut(args):
    """Ustvari .desktop bližnjico za aplikacijo."""
    for p in _desktop_write(args.name, places=("menu",)):
        log(f"Bližnjica: {p}")
    return 0

# --------------------------------------------------------------- ukazi ------

def cmd_list(args):
    apps = app_list()
    if not apps:
        log("Ni še nobene aplikacije. Dodaj jo z: wineforge add <ime> --exe <pot>")
        return 0
    print(f"{'ime':<24}{'prefix':<20}{'exe'}")
    for a in apps:
        print(f"{a['name']:<24}{(a.get('prefix') or '-'):<20}{a.get('exe')}")
    return 0


def cmd_add(args):
    exe = Path(args.exe).expanduser().resolve()
    if not exe.exists():
        die(f"Ne obstaja: {exe}")
    name = args.name or slugify(exe.stem)
    # opozori, če je izbrana datoteka dejansko NAMESTITVENIK (ne program):
    try:
        kind, _silent = detect_installer(exe)
    except Exception:
        kind = "unknown"
    if detect_webview2(exe):
        warn_webview2(exe)
    if kind != "unknown":
        warn(f"'{exe.name}' je videti kot NAMESTITVENI program ({kind}) — ne kot razširjen program.")
        warn("  'add' predvideva, da program že leži v mapi; sicer vsak zagon\n"
             "  znova zžene namestitev. Zdaj je vnos dodan kot je, uporabi pa:\n"
             f"    wineforge install \"{exe}\" --name {name}")
    prefix = args.prefix or name
    p = prefix_path(prefix)
    if not (p / "system.reg").exists():
        prefix_new(prefix, quiet=True)
    includes = []
    for spec in (args.include or []):
        src, _, win = spec.partition(":")
        includes.append({"src": str(Path(src).expanduser().resolve()),
                         "win": win or "Apps"})
    exe_win = None
    for inc in includes:
        src = Path(inc["src"])
        try:
            rel = exe.relative_to(src)
        except ValueError:
            continue
        exe_win = inc["win"].replace("/", "\\") + "\\" + str(rel).replace("/", "\\")
        break
    meta = {
        "name": name,
        "exe": str(exe),
        "exe_win": exe_win,
        "prefix": str(p),
        "include": includes,
        "sys32": [],
        "args": args.args or [],
        "env": {},
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    app_save(meta)
    auto_scale(name, meta)
    log(f"Dodano: {name}  (zaženi: wineforge run {name})")
    if not getattr(args, "no_shortcut", False):
        for p in _desktop_write(name, places=("menu", "desktop")):
            log(f"Ikona (klik): {p}")
    return 0


def cmd_run(args):
    code = app_run(args.name, args.args, debug=args.debug)
    if code and code != 0:
        warn("Namig: če se okno prikaže prazno/belo, poženi: wineforge repair " + args.name)
    return code


def cmd_repair(args):
    """Obnovi aplikacijo po okvari (belo okno, pokvarjeni podatki, WebView2)."""
    meta = app_load(args.name)
    if not meta:
        die(f"Aplikacija '{args.name}' ne obstaja.")
    prefix = Path(meta.get("prefix") or prefix_path(args.name))
    if not prefix.exists():
        die(f"Prefix ne obstaja: {prefix}")
    wineserver_kill(prefix)
    ts = time.strftime("%Y%m%d-%H%M%S")
    dc = prefix / "drive_c"
    local = dc / "users"
    changed = False

    # 1) seznam vseh map s podatki aplikacij (AppData\Local, AppData\Roaming)
    data_roots = []
    for userdir in sorted(local.glob("*")):
        for sub in ("AppData/Local", "AppData/Roaming", "Application Data"):
            d = userdir / sub
            if d.is_dir():
                data_roots.append(d)

    # 2) varnostne kopije tipa <mapa>-Backup...  -> ponudi obnovitev
    backups = []
    for root in data_roots:
        for d in sorted(root.glob("*-Backup*")):
            if d.is_dir():
                backups.append(d)
    if backups and not args.restore and not args.list_backups:
        warn("Najdene varnostne kopije podatkov (okvarjena mapa):")
        for b in backups:
            log(f"    {b.relative_to(dc)}")
        warn("Za obnovitev: wineforge repair %s --restore" % args.name)

    # 3) obnovitev: zamenjaj prazno/okvarjeno mapo z vsebino varnostne kopije
    if args.restore:
        target = None
        if args.restore is not True and str(args.restore) not in ("True", "true"):
            for b in backups:
                if str(args.restore) in b.name:
                    target = b
                    break
            if target is None:
                die(f"Varnostna kopija '{args.restore}' ne obstaja.")
        elif backups:
            target = max(backups, key=lambda p: p.stat().st_mtime)
        if target is None:
            warn("Ni najdenih varnostnih kopij za obnovitev.")
        else:
            orig = Path(str(target))
            name = target.name
            base = re.sub(r"-Backup.*$", "", name)
            dest = target.parent / base
            if dest.exists():
                old = dest.with_name(base + ".broken-" + ts)
                step(f"Obstoječa mapa -> {old.name}")
                dest.rename(old)
            step(f"Obnavljam {name} -> {base}")
            target.rename(dest)
            changed = True

    # 4) ponastavitev WebView2/Chromium profilov (reši belo okno)
    if args.list_backups:
        return 0

    if not args.no_webview:
        for root in data_roots:
            for pat in ("*/*/EBWebView", "*/EBWebView", "*/*/WebView2", "*/WebView2",
                        "*/*/Microsoft/EdgeWebView", "*/Microsoft/EdgeWebView"):
                for d in root.glob(pat):
                    if d.is_dir() and ".bak-" not in d.name:
                        new = d.with_name(d.name + ".bak-" + ts)
                        step(f"WebView2 profil -> {new.name}")
                        try:
                            d.rename(new)
                            changed = True
                        except OSError as e:
                            warn(f"  ne morem preimenovati: {e}")

    # 5) počisti Temp znotraj prefixa
    if args.clean_temp:
        for t in dc.glob("users/*/AppData/Local/Temp/*"):
            try:
                if t.is_dir():
                    shutil.rmtree(t, ignore_errors=True)
                else:
                    t.unlink()
            except OSError:
                pass
        step("Temp počiščen")
        changed = True

    if changed:
        log("")
        log("Popravljeno. Zaženi: wineforge run " + args.name)
    else:
        log("Ni bilo česa popraviti.")
    log("Namig: aplikacije NE ubijaj s 'kill -9' — zapri okno (ali Ctrl+Q),")
    log("      sicer se podatki aplikacije lahko pokvarijo in okno ostane belo.")
    return 0


def cmd_prefix(args):
    if args.action == "list":
        for p in list_prefixes():
            log(f"  {p}  ({human(du(PREFIXES / p))})")
        return 0
    if args.action == "new":
        prefix_new(args.name)
        return 0
    if args.action == "delete":
        p = prefix_path(args.name)
        wineserver_kill(p)
        if p.exists():
            shutil.rmtree(p)
            log(f"Izbrisan prefix {p}")
        return 0
    if args.action == "shell":
        p = prefix_path(args.name)
        env = wine_env(p)
        log(f"Prefix {p} — 'wine <program>' za zagon, 'exit' za izhod")
        subprocess.run([os.environ.get("SHELL", "/bin/bash")], env={**os.environ, **env})
        return 0
    if args.action == "explorer":
        p = prefix_path(args.name)
        wine(["explorer", "/desktop=shell,1024x768", r"C:\windows"], prefix=p)
        return 0
    if args.action == "tweaks":
        p = prefix_path(args.name)
        setup_defaults(p)
        log("Privzeti override-i in nastavitve ponovno uporabljeni")
        return 0
    die("neznano dejanje")


def cmd_deps(args):
    target = Path(args.target).expanduser()
    if not target.exists():
        die(f"Ne obstaja: {target}")
    step(f"Analiza: {target}")
    found, archs = scan_deps(target)
    log(f"  arhitekture: {', '.join(sorted(archs)) or '?'}")
    if not found:
        log("  ni zaznanih posebnih odvisnosti (samo sistemske Windows knjižnice)")
        return 0
    for comp, dlls in sorted(found.items()):
        log(f"  {comp:<18} <- {', '.join(sorted(dlls))}")
    if args.install:
        die("samodejno nameščanje komponent še ni implementirano v tej različici")
    return 0


def cmd_doctor_public(args):
    return cmd_doctor(args)


def cmd_info(args):
    log(f"WineForge {VERSION}")
    log(f"  motor:  {FORGE}")
    log(f"  wine:   {WINE}")
    log(f"  appi:   {len(app_list())}")
    log(f"  prefixi:{len(list_prefixes())}")
    log(f"  velikost: {human(du(FORGE))}")
    return 0


# ------------------------------------------------------------------ main ----

def build_parser():
    p = argparse.ArgumentParser(prog="wineforge", description="Prenosni Wine motor")
    p.add_argument("--version", action="version", version=f"WineForge {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("bake", help="zgradi predlogo prefixa z vsemi komponentami")
    s.add_argument("name", nargs="?")
    s.add_argument("--resume", action="store_true", help="nadaljuj prekinjeno peko")
    s.add_argument("--keep-going", action="store_true", help="ne ustavi ob napaki")
    s.add_argument("--no-pack", action="store_true", help="ne pakiraj predloge")
    s.add_argument("--with-dotnet", action="store_true", help="vkljuci .NET 4.8 in .NET 8")
    s.add_argument("--compact", action="store_true",
                   help="odstrani pomoč/Installer cache (varja ~150 MB)")
    s.set_defaults(func=cmd_bake)

    s = sub.add_parser("doctor", help="preveri delovanje motorja, GPU, CUDA")
    s.add_argument("--fix", action="store_true",
                   help="popravi, kar se da (motor, wineserver, temp, override-i)")
    s.add_argument("--keep-prefix", action="store_true", help="ne izbriši _doctor prefixa")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("info", help="osnovne informacije")
    s.set_defaults(func=cmd_info)

    s = sub.add_parser("list", help="seznam aplikacij")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("add", help="dodaj Windows aplikacijo")
    s.add_argument("name", nargs="?")
    s.add_argument("--exe", required=True)
    s.add_argument("--prefix")
    s.add_argument("--include", action="append", metavar="POT[:WINMAPA]",
                   help="celotna mapa programa, npr. /pot/do/App:Apps/App")
    s.add_argument("--args", nargs=argparse.REMAINDER)
    s.add_argument("--no-shortcut", action="store_true",
                   help="ne ustvari ikone na namizju/meniju")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("run", help="zaženi aplikacijo")
    s.add_argument("name")
    s.add_argument("--debug", action="store_true")
    s.add_argument("args", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_run)

    s = sub.add_parser("config", help="nastavitve motorja (samodejno skaliranje)")
    s.add_argument("--electron-scale", type=float, help="privzeto 1.5 (npr. 1.25, 1.75)")
    s.add_argument("--win32-dpi-scale", type=float, help="privzeto 1.0 (npr. 1.25)")
    s.add_argument("--auto-scale", choices=["on", "off"])
    s.set_defaults(func=cmd_config)

    s = sub.add_parser("scale", help="nastavi velikost vmesnika (DPI/zoom)")
    s.add_argument("name")
    s.add_argument("percent", type=int, help="npr. 100, 125, 150, 175, 200")
    s.set_defaults(func=cmd_scale)

    s = sub.add_parser("gui", help="grafični vmesnik (zenity/yad) — deluje brez terminala")
    s.set_defaults(func=cmd_gui)

    s = sub.add_parser("setup", help="samodejna priprava motorja (prenos manjkajočega)")
    s.add_argument("--check", action="store_true",
                   help="samo preveri, nič ne prenasa")
    s.add_argument("--offline", action="store_true",
                   help="ne prenašaj — uporabi samo cache (share/deps)")
    s.add_argument("--parts", action="store_true",
                   help="posekaj posamično (brez velikega paketa engine+predloga)")
    s.add_argument("--no-bundle", dest="parts", action="store_true",
                   help="isti vzdevek kot --parts")
    s.add_argument("--verify", action="store_true",
                   help="preveri sha256 motorja proti manifestu")
    s.add_argument("--manifest", action="store_true",
                   help="(znova) zapiši sha256 manifest motorja")
    s.add_argument("--no-bake", action="store_true", help="ne gradi predloge prefixa")
    s.add_argument("--with-dotnet", action="store_true", help="v predlogo dodaj .NET 4.8 + .NET 8")
    s.add_argument("--desktop", action="store_true", help="po pripravi ustvari ikono")
    s.set_defaults(func=cmd_setup)

    s = sub.add_parser("desktop", help="ikona v meniju in na namizju (klik za zagon)")
    s.add_argument("name", nargs="?", help="ime aplikacije (brez: WineForge GUI)")
    s.add_argument("--menu-only", action="store_true", help="samo meni, ne na namizje")
    s.set_defaults(func=cmd_desktop)

    s = sub.add_parser("tray", help="ikona v sistemskem pladnju (yad) — programi z enim klikom")
    s.add_argument("--quit", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(func=cmd_tray)

    s = sub.add_parser("update", help="posodobi kodo (git pull) in motor")
    s.add_argument("--no-pull", action="store_true", help="samo motor, brez git pull")
    s.set_defaults(func=cmd_update)

    s = sub.add_parser("shortcut", help="ustvari bližnjico v meniju")
    s.add_argument("name")
    s.set_defaults(func=cmd_shortcut)

    s = sub.add_parser("repair", help="popravi aplikacijo (belo okno, pokvarjeni podatki)")
    s.add_argument("name")
    s.add_argument("--restore", nargs="?", const=True, default=None,
                   help="obnovi podatke iz varnostne kopije (*-Backup*)")
    s.add_argument("--list-backups", action="store_true")
    s.add_argument("--no-webview", action="store_true", help="ne ponastavi WebView2 profila")
    s.add_argument("--clean-temp", action="store_true")
    s.set_defaults(func=cmd_repair)

    s = sub.add_parser("prefix", help="upravljanje s prefixi")
    s.add_argument("action", choices=["list", "new", "delete", "shell", "explorer", "tweaks"])
    s.add_argument("name", nargs="?")
    s.set_defaults(func=cmd_prefix)

    s = sub.add_parser("install", help="namesti program in naredi prenosno aplikacijo")
    s.add_argument("installer")
    s.add_argument("--name")
    s.add_argument("--exe", help="glavni exe (relativna pot znotraj namestitve)")
    s.add_argument("--interactive", action="store_true", help="namesti ročno (GUI)")
    s.add_argument("--args", nargs=argparse.REMAINDER)
    s.add_argument("--keep-staging", action="store_true",
                   help="obdrži začasni prefix (za diagnozo)")
    s.add_argument("--no-shortcut", action="store_true",
                   help="ne ustvari ikone na namizju/meniju")
    s.set_defaults(func=cmd_install)

    s = sub.add_parser("pack", help="naredi samostojen prenosni paket")
    s.add_argument("name")
    s.add_argument("--out", default=str(FORGE / "dist"))
    s.add_argument("--compress", action="store_true")
    s.add_argument("--no-prefix", action="store_true")
    s.add_argument("--desktop", action="store_true",
                   help="takoj ustvari ikono, ki kaže na lokacijo paketa")
    s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_pack)

    s = sub.add_parser("remove", help="odstrani aplikacijo")
    s.add_argument("name")
    s.add_argument("--keep-prefix", action="store_true")
    s.set_defaults(func=cmd_remove)

    s = sub.add_parser("deps", help="analiza odvisnosti PE datotek")
    s.add_argument("target")
    s.add_argument("--install", action="store_true")
    s.set_defaults(func=cmd_deps)

    s = sub.add_parser("media", help="predvajanje videa v igrah (preveri, dopolni)")
    s.add_argument("--fix", action="store_true",
                   help="dopolni manjkajoče GStreamer pluginje (brez roota)")
    s.set_defaults(func=cmd_media)

    s = sub.add_parser("disc", help="igre in programi s CD/DVD ali ISO slike")
    s.add_argument("--iso", help="naloži ISO sliko (npr. igra.iso)")
    s.add_argument("--install", nargs="?", const="", default=None, metavar="EXE",
                   help="namesti program z diska (brez EXE: prvi najdeni)")
    s.add_argument("--name", "--ime", dest="name", help="ime nove aplikacije")
    s.add_argument("--exe", help="glavni exe po namestitvi")
    s.add_argument("--link", metavar="PREFIX", help="poveži diske v prefix kot pogone")
    s.add_argument("--eject", action="store_true", help="odmontiraj in sprosti diske")
    s.set_defaults(func=cmd_disc)

    s = sub.add_parser("sim", help="programu daj skrbniške pravice in njegovo storitev (simulacija)")
    s.add_argument("name", help="ime nameščenega programa")
    s.add_argument("--svc", action="append", metavar="IME=C:\\pot\\Storitev.exe",
                   help="registriraj/zaženi windows storitev programa")
    s.add_argument("--rm", action="append", metavar="IME", help="odstrani simulirano storitev")
    s.add_argument("--manual", action="store_true",
                   help="storitev naj bo za zagon ročna (ne samodejno)")
    s.add_argument("--admin", action="store_true",
                   help="izklopi UAC v registru (program naj ne vpraša za pravice)")
    s.add_argument("--no-admin", action="store_true", help="razveljavi lažno povišanje")
    s.add_argument("--stop", action="store_true", help="ustavi simulirane storitve")
    s.add_argument("--status", action="store_true", help="samo prikaži stanje")
    s.add_argument("--verify", action="store_true",
                   help="v prefixu poženi sondo in pokaži, kaj program vidi (pravice, storitve, stroj)")
    s.add_argument("--win", metavar="10|11",
                   help="napiši masko Windowsa (nekateri programi zavrnejo starejše)")
    s.add_argument("--pin", action="store_true",
                   help="utrdi identiteto stroja (MachineGuid, HwProfileGuid, InstallDate)")
    s.set_defaults(func=cmd_sim)

    s = sub.add_parser("pad", help="navidezni Xbox gamepad za igre (uinput, brez roota)")
    s.add_argument("--start", action="store_true", help="ustvari napravo in zagni daemon")
    s.add_argument("--stop", action="store_true", help="ustavi daemona in odstrani napravo")
    s.add_argument("--daemon", action="store_true", help="notranji: drzi napravo (ne rabiš)")
    s.add_argument("--name", metavar="IME", help="ime naprave, kot ga vidi igra")
    s.add_argument("--press", metavar="GUMB", help="prekratko pritisni gumb (a b x y lb rb start back guide ...)")
    s.add_argument("--hold", metavar="S", help="dolžina pritiska v sekundah")
    s.add_argument("--axis", nargs=2, metavar=("OS", "VREDNOST"),
                   help="premakni os (lx ly rx ry lt rt) na vrednost od -1 do 1")
    s.add_argument("--dpad", metavar="DESNO|LEVO|GOR|DOL|none", help="premakni navzkrižni gumb")
    s.add_argument("--seq", metavar="NIZ", help="niz: a:0.2:400,b:0.2:200 (gumb:pritisk:pavza_ms)")
    s.add_argument("--demo", action="store_true", help="pošlji nekaj vnosov za preizkus")
    s.set_defaults(func=cmd_pad)

    return p


def main(argv=None):
    for d in (PREFIXES, APPS, DATA, LOGS, TEMPLATES, DEPS):
        d.mkdir(parents=True, exist_ok=True)
    ap = build_parser()
    args = ap.parse_args(argv)
    if not getattr(args, "func", None):
        ap.print_help()
        return 0
    # prvi zagon na novem računalniku: motor se pripravi sam (razen pri
    # gui/setup/doctor/tray/update — ti to zmorejo sami oz. so namerni):
    if args.cmd not in ("doctor", "setup", "gui", "config", "tray", "update", "media") \
            and setup_missing():
        ensure_ready()
    return args.func(args) or 0


if __name__ == "__main__":
    sys.exit(main())
