    "dxgi.dll": "dxvk",
    "vulkan-1.dll": "vulkan",
    "libEGL.dll": "dxvk",
    "libGLESv2.dll": "dxvk",
    "python3.dll": None,
    "libcrypto-3-x64.dll": None,
    "physxloader.dll": "physx",
    "openal32.dll": "openal",
    "avcodec-58.dll": None,
}


def scan_deps(target):
    """Analizira PE datoteke in vrne slovar komponent -> dokazi."""
    target = Path(target)
    files = []
    if target.is_dir():
        for root, _d, fs in os.walk(target):
            for f in fs:
                if f.lower().endswith((".exe", ".dll", ".ocx", ".cpl", ".scr")):
                    files.append(Path(root) / f)
            if len(files) > 4000:
                break
    else:
        files = [target]
    found = {}
    archs = set()
    for f in files:
        try:
            pe = PE(f)
        except (OSError, struct.error):
            continue
        if not pe.ok:
            continue
        if pe.machine:
            archs.add("x86_64" if pe.machine == 0x8664 else "i386")
        for dll in pe.imports:
            comp = DEP_MAP.get(dll) or DEP_MAP.get(dll.lower())
            if comp:
                found.setdefault(comp, set()).add(dll)
    return found, archs


