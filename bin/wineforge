#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
WineForge — prenosni Wine motor za Linux
========================================
Ena mapa = celoten Windows okoljski sklad: Wine runtime, DXVK, VKD3D, CUDA
(nvidia-libs), VC++/.NET/WebView2 komponente, predpripravljeni prefixi in
orodja za pretvorbo namestitvenih programov v prenosne aplikacije.

Vse poti so relativne na koren motorja (mapa, kjer je ta datoteka v bin/),
zato motor deluje iz katerekoli lokacije, tudi z USB ključa.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.1.0"

README_TXT = """Prenosni paket: {name}
============================================================

ZAGON
  ./run.sh            (v terminalu, ali dvoklik na run.sh)

  IKONA (klik brez terminala, "appimage" stil):
      ./register.sh      ustvari ikono na namizju in v meniju (poženi ENKRAT)
      potem samo klikneš na ikono in dela.

  Prvi zagon lahko traja nekaj minut (Wine pripravi prefix).

KAJ VSEBUJE
  engine/wine          Wine 11.22 (64-bit + 32-bit, wow64)
  engine/nvidia-libs   CUDA, NVML, NVAPI, NVENC, NvOptix (za NVIDIA GPU)
  engine/tools         winetricks (offline predpomnilnik v share/verbs)
  share/templates      predpripravljen osnovni prefix (VC++, .NET, WebView2, DXVK)
  prefixes/{name}      prefix te aplikacije (nastavitve, podatki, shramba)
  apps/{name}          program + njegove datoteke

ZAHTEVE
  64-bit Linux, glibc >= 2.31, Vulkan gonilnik (NVIDIA/AMD/Intel).
  Priporoceno: NVIDIA gonilnik 580+ za CUDA pospesevanje.

POMEMBNO — NE UBIVAJ APLIKACIJE NA SILO
  Ce aplikacijo ubijes s 'kill -9' (ali ce se sesuje med pisanjem),
  se lahko njeni podatki pokvarijo in okno ostane BELO.
  Zapri jo z gumbom X ali Ctrl+Q.

CE JE OKNO BELO / PRAZNO
  ./bin/wineforge repair {name}          # ponastavi WebView2 profil
  ./bin/wineforge repair {name} --restore  # obnovi podatke iz varnostne kopije

DRUGI UKAZI
  ./bin/wineforge list                  seznam aplikacij
  ./bin/wineforge doctor                diagnoza (Wine, GPU, Vulkan, CUDA)
  ./bin/wineforge run {name} --debug    zagon z izpisi
  ./bin/wineforge prefix shell {name}   ukazna vrstica znotraj prefixa
  ./bin/wineforge pack {name} --out .   naredi nov prenosni paket

PRENOS NA DRUG RACUNALNIK
  Kopiraj celotno mapo (npr. na USB). Poti so relativne, zato deluje
  iz katerekoli lokacije. Ce kopiras na filesystem brez podpore za
  trde povezave (FAT32), uporabi: rsync -a --no-hard-links
"""


# ---------------------------------------------------------------- poti ------

FORGE = Path(os.environ.get("WINEFORGE_DIR") or Path(__file__).resolve().parent.parent)
ENGINE = FORGE / "engine"
WINE_DIR = ENGINE / "wine"
WINE = WINE_DIR / "bin" / "wine"
WINESERVER = WINE_DIR / "bin" / "wineserver"
WINEBOOT = WINE_DIR / "bin" / "wineboot"
WINE64 = WINE_DIR / "bin" / "wine64"
NVLIBS = ENGINE / "nvidia-libs"
TOOLS = ENGINE / "tools"
TOOLSBIN = TOOLS / "bin"   # prenosli orodji (cabextract) — ni odvisno od sistema
SHARE = FORGE / "share"
TEMPLATES = SHARE / "templates"
DEPS = SHARE / "deps"
APPS = FORGE / "apps"
PREFIXES = FORGE / "prefixes"
DATA = FORGE / "data"
LOGS = DATA / "logs"

BASE_TEMPLATE = TEMPLATES / "base-prefix.tar.zst"

# --------------------------------------------------------------- pomožno ----


def log(msg=""):
    print(msg, flush=True)


def step(msg):
    print("\033[1;36m==>\033[0m " + msg, flush=True)


def warn(msg):
    print("\033[1;33m[!]\033[0m " + msg, flush=True)


def err(msg):
    print("\033[1;31m[x]\033[0m " + msg, flush=True)


def die(msg, code=1):
    err(msg)
    sys.exit(code)


def human(n):
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024.0


def du(path):
    total = 0
    for root, _dirs, files in os.walk(path, followlinks=False):
        for f in files:
            p = os.path.join(root, f)
            try:
                if not os.path.islink(p):
                    total += os.path.getsize(p)
            except OSError:
                pass
    return total


def run(cmd, env=None, check=False, capture=False, quiet=False):
    """Zažene ukaz, vrne (koda, stdout)."""
    if not quiet:
        pass
    e = os.environ.copy()
    if env:
        e.update({k: str(v) for k, v in env.items() if v is not None})
    if capture:
        p = subprocess.run(cmd, env=e, text=True, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT)
        return p.returncode, p.stdout
    p = subprocess.run(cmd, env=e)
    if check and p.returncode:
        die(f"Ukaz ni uspel ({p.returncode}): {' '.join(map(str, cmd))}")
    return p.returncode, ""


def slugify(name):
    s = re.sub(r"[^a-zA-Z0-9]+", "-", name.strip().lower()).strip("-")
    return s or "app"


# --------------------------------------------------------------- okolje -----

DEFAULT_ENV = {
    # tišina: fixme sporočila samo smetijo v konzolo
    "WINEDEBUG": "-fixme-all",
    # sinhronizacija niti (fsync je hitrejši, esync rezerva)
    "WINEFSYNC": "1",
    "WINEESYNC": "1",
    # DXVK / VKD3D
    "DXVK_LOG_LEVEL": "none",
    "DXVK_STATE_CACHE": "1",
    "DXVK_STATE_CACHE_PATH": None,          # nastavi se na prefix
    "VKD3D_DEBUG": "none",
    "DXVK_NVAPI_LOG_LEVEL": "none",
    # CUDA/NVML iz nvidia-libs
    "CUDA_FAKE_LUID": None,
}


def wine_env(prefix=None, extra=None, debug=False):
    """Zgradi okolje za zagon Wine."""
    env = dict(DEFAULT_ENV)
    # vgrajene (bundlane) knjižnice imajo prednost
    libdir = ENGINE / "lib"
    if libdir.is_dir():
        env["LD_LIBRARY_PATH"] = f"{libdir}:" + os.environ.get("LD_LIBRARY_PATH", "")
    if prefix:
        p = Path(prefix).expanduser().resolve()
        env["WINEPREFIX"] = str(p)
        env["DXVK_STATE_CACHE_PATH"] = str(p / "dxvk-cache")
        (p / "dxvk-cache").mkdir(parents=True, exist_ok=True)
    env["WINEARCH"] = "win64"
    if debug:
        env["WINEDEBUG"] = "+loaddll,+module"
    if extra:
        env.update({k: str(v) for k, v in extra.items() if v is not None})
    # počisti None vrednosti (subprocess jih ne prenese)
    return {k: str(v) for k, v in env.items() if v is not None}


def wine(cmd, prefix=None, env=None, capture=False, debug=False, check=False):
    """Zažene wine <cmd...>."""
    full = [str(WINE)] + [str(c) for c in cmd]
    return run(full, env=wine_env(prefix, env, debug), capture=capture, check=check)


def wineserver_kill(prefix):
    if WINESERVER.exists():
        run([str(WINESERVER), "-k"], env=wine_env(prefix), capture=True)


def wait_wineserver(prefix, timeout=30):
    t0 = time.time()
    while time.time() - t0 < timeout:
        code, _ = run([str(WINESERVER), "-w"], env=wine_env(prefix), capture=True)
        if code == 0:
            return True
        time.sleep(0.5)
    return False


# ------------------------------------------------------- registri/overrides --

def reg_add(prefix, key, name, value, vtype="REG_SZ"):
    code, out = wine(["reg", "add", key, "/v", name, "/t", vtype, "/d", value, "/f"],
                     prefix=prefix, capture=True)
    return code == 0


def reg_delete(prefix, key, name):
    wine(["reg", "delete", key, "/v", name, "/f"], prefix=prefix, capture=True)


DLL_OVERRIDES = {
    # DXVK (Direct3D 9/10/11 prek Vulkan)
    "*d3d8": "native", "*d3d9": "native", "*d3d10core": "native",
    "*d3d11": "native", "*dxgi": "native",
    # VKD3D-Proton (Direct3D 12 prek Vulkan)
    "*d3d12": "native", "*d3d12core": "native",
    # CUDA / NVIDIA (nvidia-libs)
    "nvcuda": "native", "nvml": "native", "nvapi64": "native",
    "nvcuvid": "native", "nvencodeapi64": "native",
}


def apply_overrides(prefix, overrides=None):
    ov = dict(DLL_OVERRIDES)
    if overrides:
        ov.update(overrides)
    for dll, mode in ov.items():
        reg_add(prefix, r"HKEY_CURRENT_USER\Software\Wine\DllOverrides", dll, mode)


def link_nvidia_libs(prefix):
    """Vpne nvcuda/nvml/nvapi iz engine/nvidia-libs v system32 (symlink + override)."""
    if not NVLIBS.is_dir():
        return False
    sys32 = Path(prefix) / "drive_c" / "windows" / "system32"
    sys32.mkdir(parents=True, exist_ok=True)
    x64 = NVLIBS / "x64"
    n = 0
    # 64-bit: nvcuda/nvml/... so ELF winelib -> symlink + override native
    for dll in ("nvcuda.dll", "nvml.dll", "nvoptix.dll", "nvcuvid.dll",
                "nvencodeapi64.dll", "nvofapi64.dll", "nvapi64.dll"):
        src = x64 / dll
        if src.exists():
            dst = sys32 / dll
            if dst.is_symlink() or dst.exists():
                dst.unlink()
            dst.symlink_to(src)
            n += 1
    # 32-bit nvapi (edini 32-bit kos v paketu)
    x32 = NVLIBS / "x32" / "nvapi.dll"
    if x32.exists():
        syswow = Path(prefix) / "drive_c" / "windows" / "syswow64"
        if syswow.is_dir():
            dst = syswow / "nvapi.dll"
            if dst.is_symlink() or dst.exists():
                dst.unlink()
            dst.symlink_to(x32)
            n += 1
    return n > 0


# ------------------------------------------------------------ prefixi -------

def prefix_path(name):
    p = Path(name).expanduser()
    if p.is_absolute():
        return p
    return PREFIXES / name


def list_prefixes():
    if not PREFIXES.is_dir():
        return []
    return sorted([d.name for d in PREFIXES.iterdir() if (d / "system.reg").exists()])


def prefix_new(name, template=True, quiet=False):
    dest = prefix_path(name)
    if (dest / "system.reg").exists():
        if not quiet:
            warn(f"Prefix '{name}' že obstaja: {dest}")
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    if template and BASE_TEMPLATE.exists():
        step(f"Razpakiranje predloge v {dest}")
        dest.mkdir(parents=True, exist_ok=True)
        code, out = run(["tar", "--zstd", "-xf", str(BASE_TEMPLATE), "-C", str(dest)],
                        capture=True)
        if code:
            die("Razpakiranje predloge ni uspelo:\n" + out)
        fix_prefix_paths(dest)
        # predloga je lahko nastavljena na staro Windows različico -> popravi
        setup_defaults(dest, quiet=quiet)
    else:
        step(f"Ustvarjam nov Wine prefix: {dest}")
        dest.mkdir(parents=True, exist_ok=True)
        wine(["wineboot", "-u"], prefix=dest, capture=True)
        wait_wineserver(dest)
        setup_defaults(dest, quiet=quiet)
    return dest


def fix_prefix_paths(prefix):
    """Popravi absolutne poti v registru, če je bil prefix prestavljen."""
    prefix = Path(prefix)
    sp = str(prefix)
    for reg in ("system.reg", "user.reg"):
        f = prefix / reg
        if not f.exists():
            continue
        try:
            txt = f.read_text(errors="surrogateescape")
        except OSError:
            continue
        # registri vsebujejo poti tipa Z:\home\user\...\prefix\drive_c
        # zamenjamo samo, če se je koren spremenil (premaknjen motor)
        m = re.search(r'^#arch=', txt, re.M)
        if m is None and reg == "system.reg":
            continue
    return True


def setup_defaults(prefix, quiet=False):
    """Osnovna konfiguracija svežega prefixa (brez namestitve komponent)."""
    step("Nastavljam privzete DLL override-e (DXVK, VKD3D, CUDA)")
    apply_overrides(prefix)
    if link_nvidia_libs(prefix):
        log("    NVIDIA knjižnice (nvcuda/nvml/nvapi) vpete")
    # Windows različica 10 (večina sodobnih programov zahteva; winecfg posodobi
    # tudi HKLM\...\CurrentVersion, kar nekateri installerji preverjajo)
    reg_add(prefix, r"HKEY_CURRENT_USER\Software\Wine", "Version", "win10")
    wine(["winecfg", "-v", "win10"], prefix=prefix, capture=True)
    wineserver_kill(prefix)
    wait_wineserver(prefix, 15)
    # brez "gecko/mshtml opozoril" in podobnih dialogov
    reg_add(prefix, r"HKEY_CURRENT_USER\Software\Wine\WineDbg", "ShowCrashDialog", "0")
    # privzeti DPI 96 (ostri UI)
    reg_add(prefix, r"HKEY_CURRENT_USER\Control Panel\Desktop", "LogPixels", "96")
    return True


# ------------------------------------------------------------------ appi ----

def app_dir(name):
    return APPS / slugify(name)


def app_load(name):
    d = app_dir(name)
    f = d / "app.json"
    if not f.exists():
        return None
    meta = json.loads(f.read_text())
    # prenosni zapisi: relativne poti razreši glede na motor
    if meta.get("prefix") and not Path(meta["prefix"]).is_absolute():
        meta["prefix"] = str(prefix_path(meta["prefix"]))
    for inc in meta.get("include", []):
        src = Path(inc["src"])
        if not src.is_absolute():
            cand = d / src
            if cand.exists():
                inc["src"] = str(cand)
    return meta


def app_save(meta):
    d = app_dir(meta["name"])
    d.mkdir(parents=True, exist_ok=True)
    (d / "app.json").write_text(json.dumps(meta, indent=2, ensure_ascii=False))
    return d


def app_list():
    out = []
    if APPS.is_dir():
        for d in sorted(APPS.iterdir()):
            f = d / "app.json"
            if f.exists():
                try:
                    out.append(json.loads(f.read_text()))
                except json.JSONDecodeError:
                    pass
    return out


CONFIG_FILE = DATA / "config.json"

DEFAULT_CONFIG = {
    # Electron/Chromium programi (VS Code, TTS, Discord ...): povečaj vmesnik,
    # ker Chromium pod Wine ignorira sistemski DPI
    "electron_scale": 1.5,
    # klasični Win32 programi: 1.0 = 96 DPI (normalno)
    "win32_dpi_scale": 1.0,
    # če je False, se samodejno skaliranje ne izvaja
    "auto_scale": True,
}


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    try:
        if CONFIG_FILE.exists():
            cfg.update(json.loads(CONFIG_FILE.read_text()))
    except Exception:
        pass
    return cfg


def save_config(cfg):
    DATA.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))


def find_electron_exe(exe, depth=3):
    """Poišče Electron/Chromium binarko (tudi v podmapah, omejena globina)."""
    exe = Path(exe)
    if is_electron(exe):
        return exe
    base = exe.parent
    cur = [base]
    for _ in range(depth):
        nxt = []
        for d in cur:
            try:
                for sub in d.iterdir():
                    if sub.is_dir():
                        nxt.append(sub)
                        for f in sub.glob("*.exe"):
                            if is_electron(f):
                                return f
            except OSError:
                continue
        cur = nxt
    return None


def auto_scale(name, meta=None):
    """Samodejno nastavi velikost vmesnika, če še ni nastavljena."""
    cfg = load_config()
    if not cfg.get("auto_scale", True):
        return False
    meta = meta or app_load(name)
    if not meta:
        return False
    exe = Path(meta["exe"])
    if not exe.is_absolute():
        exe = app_dir(name) / exe
    el = find_electron_exe(exe)
    args_list = list(meta.get("args") or [])
    has_flag = any(str(a).startswith("--force-device-scale-factor") for a in args_list)
    if el and not has_flag:
        factor = float(cfg.get("electron_scale") or 1.0)
        if abs(factor - 1.0) > 0.01:
            args_list.append(f"--force-device-scale-factor={factor:g}")
            meta["args"] = args_list
            app_save(meta)
            log(f"  samodejno skaliranje vmesnika: {factor:g}x (Electron)")
            return True
        return False
    if not el:
        want = int(round(96 * float(cfg.get("win32_dpi_scale") or 1.0)))
        if want != 96:
            prefix = Path(meta["prefix"])
            reg = prefix / "user.reg"
            try:
                txt = reg.read_text(errors="surrogateescape")
            except OSError:
                txt = ""
            if f'"LogPixels"="{want}"' not in txt and f'"LogPixels"=dword:{want:08x}' not in txt:
                reg_add(prefix, r"HKEY_CURRENT_USER\\Control Panel\\Desktop",
                        "LogPixels", str(want))
                wineserver_kill(prefix)
                wait_wineserver(prefix, 10)
                log(f"  samodejno skaliranje (DPI): {want}")
                return True
    return False


def app_run(name, args=None, debug=False):
    meta = app_load(name)
    if not meta:
        die(f"Aplikacija '{name}' ne obstaja. Uporabi: wineforge list")
    prefix = prepare_app_prefix(name)
    if auto_scale(name, meta):
        meta = app_load(name) or meta
    exe = Path(meta["exe"])
    if not exe.is_absolute():
        exe = app_dir(name) / exe
    target = str(exe)
    if meta.get("exe_win"):
        target = meta["exe_win"]
    elif not exe.exists():
        die(f"Exe ne obstaja: {exe}")
    env = meta.get("env", {})
    cmd = [str(WINE), target] + list(args or [])
    if meta.get("args") and not args:
        cmd = [str(WINE), target] + list(meta["args"])
    log(f"Zaganjam {meta['name']} (prefix: {prefix})")
    code, _ = run(cmd, env=wine_env(prefix, env, debug))
    return code


# ------------------------------------------------------- analiza PE ---------

class PE:
    """Minimalni bralnik PE datotek (samo uvozi)."""

    def __init__(self, path):
        self.path = Path(path)
        self.data = self.path.read_bytes()
        self.ok = False
        self.imports = set()
        self.machine = None
        self.subsystem = None
        self._parse()

    def _parse(self):
        d = self.data
        if len(d) < 0x40 or d[:2] != b"MZ":
            return
        e_lfanew = struct.unpack_from("<I", d, 0x3C)[0]
        if e_lfanew + 24 > len(d) or d[e_lfanew:e_lfanew + 4] != b"PE\0\0":
            return
        coff = e_lfanew + 4
        self.machine, nsec, _, _, _, opt_size, chars = struct.unpack_from("<HHIIIHH", d, coff)
        opt = coff + 20
        magic = struct.unpack_from("<H", d, opt)[0]
        if magic == 0x20B:      # PE32+
            self.subsystem = struct.unpack_from("<H", d, opt + 0x5C)[0]
            ndd_off = opt + 0x6C
        else:                   # PE32
            self.subsystem = struct.unpack_from("<H", d, opt + 0x44)[0]
            ndd_off = opt + 0x60
        ndd = struct.unpack_from("<I", d, ndd_off)[0]
        if ndd == 0:
            return
        # sekcije
        sec_off = opt + opt_size
        sections = []
        for i in range(nsec):
            o = sec_off + i * 40
            if o + 40 > len(d):
                return
            name = d[o:o + 8].rstrip(b"\0").decode("latin-1")
            vsize, vaddr, rsize, raddr = struct.unpack_from("<IIII", d, o + 8)
            sections.append((vaddr, max(vsize, rsize), raddr, rsize))

        def rva2off(rva):
            for vaddr, vsize, raddr, rsize in sections:
                if vaddr <= rva < vaddr + vsize:
                    delta = rva - vaddr
                    if delta < rsize:
                        return raddr + delta
                    return None
            return None

        imp_off = ndd_off + 8  # drugi direktorij = import
        imp_rva = struct.unpack_from("<I", d, imp_off)[0]
        if not imp_rva:
            return
        off = rva2off(imp_rva)
        if off is None:
            return
        while off + 20 <= len(d):
            ilt, ts, fc, name_rva, iat = struct.unpack_from("<IIIII", d, off)
            if name_rva == 0:
                break
            no = rva2off(name_rva)
            if no is None:
                break
            end = d.find(b"\0", no)
            dll = d[no:end].decode("latin-1").lower()
            if dll:
                self.imports.add(dll)
            off += 20
        self.ok = True


