def scan_deps(target):
    """Analizira PE datoteke in vrne slovar komponent -> dokazi."""
    target = Path(target)
    files = []
    if target.is_dir():
        for root, _d, fs in os.walk(target):
            for f in fs:
                if f.lower().endswith((".exe", ".dll", ".ocx", ".cpl", ".scr")):
                    files.append(Path(root) / f)
            if len(files) > 4000:
                break
    else:
        files = [target]
    found = {}
    archs = set()
    for f in files:
        try:
            pe = PE(f)
        except (OSError, struct.error):
            continue
        if not pe.ok:
            continue
        if pe.machine:
            archs.add("x86_64" if pe.machine == 0x8664 else "i386")
        for dll in pe.imports:
            comp = DEP_MAP.get(dll) or DEP_MAP.get(dll.lower())
            if comp:
                found.setdefault(comp, set()).add(dll)
    return found, archs


# ------------------------------------------------- predvajanje videa (MF) ---
# Winejev Media Foundation (uvodni videi, predvajalniki v igrah in programih)
# dela prek sistemskega GStreamerja. Če manjka demuxer ali dekoder, igra pade z
# "Failed to create SourceReader with registered byte stream handler (0x80004005)".

GST_ELEMENTS = [
    ("typefindfunctions", "prepoznavanje vrste datoteke"),
    ("decodebin3",        "samodejna vzpostavitev verige"),
    ("qtdemux",           "MP4/MOV — najpogostejši video v igrah"),
    ("matroskademux",     "MKV/WebM"),
    ("avdec_h264",        "H.264 dekodiranje (FFmpeg)"),
    ("avdec_h265",        "HEVC/H.265 dekodiranje (FFmpeg)"),
]

# paketi, ki te elemente vsebujejo (Arch imena)
GST_PACKAGES = ["gst-plugins-good", "gst-plugins-base", "gst-plugins-bad", "gst-libav"]


def gst_bin():
    return shutil.which("gst-inspect-1.0")


def gst_env():
    e = dict(os.environ)
    if GST_BUNDLED.is_dir():
        cur = e.get("GST_PLUGIN_PATH", "")
        e["GST_PLUGIN_PATH"] = (f"{GST_BUNDLED}:{cur}" if cur else str(GST_BUNDLED))
    return e


def gst_has(element):
    """True/False ali None (če GStreamer sploh ni nameščen)."""
    g = gst_bin()
    if not g:
        return None
    code, _ = run([g, element], env=gst_env(), capture=True)
    return code == 0


def gst_version():
    g = gst_bin()
    if not g:
        return ""
    code, out = run([g, "--version"], capture=True)
    m = re.search(r"(?i)version\s+(\d+\.\d+(?:\.\d+)?)", out or "")
    if not m:
        m = re.search(r"\d+\.\d+\.\d+", out or "")
    return m.group(1) if m else ""


def media_missing():
    """(seznam manjkajočih elementov, razlog) — razlog '' pomeni 'gre popraviti'."""
    if not gst_bin():
        return [(n, d) for n, d in GST_ELEMENTS], "GStreamer (gst-inspect-1.0) ni nameščen"
    return [(n, d) for n, d in GST_ELEMENTS if not gst_has(n)], ""


def _so_loads(path):
    """Naloži .so, da vidimo, ali so vse odvisnosti na voljo."""
    try:
        ctypes.CDLL(str(path))
        return True
    except OSError:
        return False


def _is_arch():
    try:
        t = Path("/etc/os-release").read_text(errors="ignore").lower()
    except OSError:
        return False
    return any(i in t for i in ("endeavouros", "arch", "manjaro", "garuda", "cachyos"))


def _arch_pkg(name):
    """(url, pkgver) za x86_64 paket na Archem ali (None, None)."""
    code, out = run(["curl", "-sL", "--fail", "--retry", "2",
                     f"https://archlinux.org/packages/search/json/?name={name}"],
                    capture=True)
    if code:
        return None, None
    try:
        data = json.loads(out)
    except ValueError:
        return None, None
    for r in data.get("results", []):
        if r.get("pkgname") != name or r.get("arch") not in ("x86_64", "any"):
            continue
        fn = r.get("filename")
        if not fn:
            continue
        return (f"https://geo.mirror.pkgbuild.com/{r.get('repo', 'extra')}/os/x86_64/{fn}",
                r.get("pkgver", ""))
    return None, None


def media_hint():
    return ("Namesti manjkajoče-pluginske pakete:\n"
            "  Arch/EndeavourOS: sudo pacman -S gst-plugins-good gst-plugins-base "
            "gst-plugins-bad gst-libav\n"
            "  Debian/Ubuntu:    sudo apt install gstreamer1.0-plugins-good "
            "gstreamer1.0-plugins-bad gstreamer1.0-libav\n"
            "  Fedora:           sudo dnf install gstreamer1.0-plugins-good "
            "gstreamer1.0-plugins-bad gstreamer1.0-libav")


def media_fix():
    """Dopolni manjkajoče GStreamer pluginje brez roota (engine/tools/gstreamer)."""
    missing, why = media_missing()
    if not missing:
        log("Predvajanje videa je že popolno — ni kaj popravljati.")
        return True
    if why:
        warn(why + " — samodejni prenos na tej poti ni mogoč.")
        log(media_hint())
        return False
    if not _is_arch():
        warn("Samodejni prenos pluginov je pripravljen za Arch/EndeavourOS.")
        log(media_hint())
        return False
    gv = gst_version()
    step(f"Dopolnjujem predvajanje videa (GStreamer {gv or '?'})")
    tmp = Path(tempfile.mkdtemp(prefix="wfgst-"))
    got = 0
    try:
        for pkg in GST_PACKAGES:
            url, pver = _arch_pkg(pkg)
            if not url:
                warn(f"  {pkg}: paketa ni najti")
                continue
            if gv and pver and pver != gv:
                warn(f"  {pkg}: {pver} se ne ujema s sistemskim {gv} (ABI) — preskočem")
                continue
            try:
                arc = download(url, DEPS / Path(url).name)
            except RuntimeError as exc:
                warn(f"  {pkg}: {exc}")
                continue
            code, out = run(["tar", "--zstd", "-xf", str(arc), "-C", str(tmp)],
                            capture=True)
            src = tmp / "usr" / "lib" / "gstreamer-1.0"
            if code or not src.is_dir():
                warn(f"  {pkg}: razpakiranje ni uspelo")
                continue
            GST_BUNDLED.mkdir(parents=True, exist_ok=True)
            n = 0
            for so in sorted(src.glob("*.so")):
                if _so_loads(so):
                    shutil.copy2(so, GST_BUNDLED / so.name)
                    n += 1
            log(f"  {pkg}: {n} uporabnih pluginov")
            got += n
            if not media_missing()[0]:
                break   # vse potrebno je ze na voljo
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    still, _ = media_missing()
    if still:
        warn(f"Še vedno manjka: {', '.join(n for n, _ in still)}")
        log(media_hint())
        return got > 0
    log("Predvajanje videa je zdaj popolno (vgrajeno v engine/tools/gstreamer).")
    return True


def cmd_media(args):
    step("Predvajanje videa v Wine (Media Foundation)")
    if not gst_bin():
        warn("GStreamer ni nameščen — Wine ne more predvajati videa.")
        log(media_hint())
        return 1 if args.fix and not media_fix() else 1
    for el, desc in GST_ELEMENTS:
        ok = gst_has(el)
        mark = "\033[1;32m✓\033[0m" if ok else ("?" if ok is None else "\033[1;31m✗\033[0m")
        print(f" {mark} {el:<18} {desc}")
    if GST_BUNDLED.is_dir():
        n = len(list(GST_BUNDLED.glob("*.so")))
        log(f"  vgrajeni plugini: {GST_BUNDLED} ({n} kosov)")
    missing, _ = media_missing()
    if not missing:
        log("\nVse potrebne komponente so na voljo — uvodni videi in predvajalniki")
        log("v igrah bodo delovali.")
        return 0
    log(f"\nManjka: {', '.join(n for n, _ in missing)}")
    log("Posledica v igrah: okno \"Failed to create SourceReader with registered")
    log(" byte stream handler\" in taksnen izhod igre.")
    if args.fix:
        return 0 if media_fix() else 1
    log("\nPopravek brez roota:  wineforge media --fix")
    return 1


# --------------------------------------------------- DXVK-NVAPI (DLSS/RT) ---
# Za novejse igre (DLSS, DLSS Frame Generation, Reflex, sledenje žarkov) Wine
# potrebuje DXVK-NVAPI — NVIDIA-jev windowski nvapi64.dll pod Wine ne dela
# ( govori z windowskim gonilnikom). Proton/Bottles ga vgradijo privzeto, tukaj
# ga dodamo sami (enkratni prenos ~6 MB, potem iz predpomnilnika).

NVAPI_REPO = ("jp7677", "dxvk-nvapi")
NVAPI_CACHE = DATA / "nvapi"
NVAPI_LAYER = NVAPI_CACHE / "layer"


def nvapi_variant(prefix):
    """'dxvk-nvapi', 'nvidia' ali 'ni' — kateri nvapi64.dll je v prefixu."""
    f = Path(prefix) / "drive_c" / "windows" / "system32" / "nvapi64.dll"
    if not f.exists():
        return "ni"
    try:
        data = f.read_bytes()
    except OSError:
        return "?"
    if b"DXVK_NVAPI" in data or b"DXVK-NVAPI" in data:
        return "dxvk-nvapi"
    return "nvidia"


def _nvapi_latest():
    """Verzija zadnje izdaje DXVK-NVAPI (ali None, ce ni povezave)."""
    code, out = run(["curl", "-sL", "--fail", "--retry", "2",
                     f"https://api.github.com/repos/{NVAPI_REPO[0]}/{NVAPI_REPO[1]}"
                     "/releases/latest"], capture=True)
    if code:
        return None
    try:
        return (json.loads(out).get("tag_name") or "").lstrip("v") or None
    except ValueError:
        return None


def _nvapi_cache(ver):
    """Razpakira DXVK-NVAPI v predpomnilnik; vrne mapo z dll-ji ali None."""
    d = NVAPI_CACHE / ver
    if (d / "nvapi64.dll").exists():
        return d
    url = (f"https://github.com/{NVAPI_REPO[0]}/{NVAPI_REPO[1]}/releases/download/"
           f"v{ver}/dxvk-nvapi-v{ver}.tar.gz")
    try:
        arc = download(url, DEPS / f"dxvk-nvapi-v{ver}.tar.gz")
    except RuntimeError:
        return None
    tmp = Path(tempfile.mkdtemp(prefix="wfnvapi-"))
    try:
        code, _ = run(["tar", "xzf", str(arc), "-C", str(tmp)], capture=True)
        if code:
            return None
        d.mkdir(parents=True, exist_ok=True)
        for dll in tmp.rglob("*.dll"):
            if dll.parent.name in ("x64", "x32"):
                shutil.copy2(dll, d / dll.name)
        for exe in tmp.rglob("dxvk-nvapi*.exe"):
            if "tests" not in exe.name:
                shutil.copy2(exe, d / exe.name)
        lay = tmp / "layer"
        if lay.is_dir():
            NVAPI_LAYER.mkdir(parents=True, exist_ok=True)
            for f in lay.iterdir():
                shutil.copy2(f, NVAPI_LAYER / f.name)
        return d if (d / "nvapi64.dll").exists() else None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def ensure_nvapi(prefix, quiet=False):
    """V prefix vgradi DXVK-NVAPI (DLSS, Reflex, RT) — enako kot Proton."""
    p = Path(prefix)
    if not (p / "drive_c" / "windows" / "system32").is_dir():
        return False
    if nvapi_variant(p) == "dxvk-nvapi":
        return True
    ver = _nvapi_latest()
    if not ver:
        if not quiet:
            warn("DXVK-NVAPI: GitHub ni dosegljiv — izpustim (DLSS morda ne dela)")
        return False
    d = _nvapi_cache(ver)
    if not d:
        if not quiet:
            warn("DXVK-NVAPI: prenosa/razpakiranja ni uspelo — izpustim")
        return False
    cilji = (("system32", "nvapi64.dll"), ("syswow64", "nvapi.dll"),
               ("system32", "nvofapi64.dll"))
    for folder, name in cilji:
        src = d / name
        if not src.exists():
            continue
        dst = p / "drive_c" / "windows" / folder / name
        try:
            dst.parent.mkdir(parents=True, exist_ok=True)
            if dst.is_symlink() or dst.exists():
                dst.unlink()
            shutil.copy2(src, dst)
        except OSError:
            return False
    orodje = d / "dxvk-nvapi.exe"
    if orodje.exists():
        try:
            shutil.copy2(orodje, p / "drive_c" / "windows" / "system32" / "dxvk-nvapi.exe")
        except OSError:
            pass
    reg_add(p, r"HKEY_CURRENT_USER\Software\Wine\DllOverrides", "nvapi64", "native")
    reg_add(p, r"HKEY_CURRENT_USER\Software\Wine\DllOverrides", "nvapi", "native")
    if not quiet:
        log(f"    DXVK-NVAPI {ver} vpet (DLSS / Reflex / sledenje zarkov)")
    return True


# ------------------------------------------------------------------ diski ----
# Podpora za igre/programme na CD/DVD (pravi pogon ali ISO slika). Vse brez
# roota: udisks2 poskrbi za zanko in montažo, Wine dobi pogon v dosdevices/.

DISC_FSTYPES = ("iso9660", "udf", "cd9660")
DISC_LETTERS = "DEFGHIJKLMNOPQRSTUVWXYZ"
DISC_INSTALLERS = ("setup.exe", "setup64.exe", "setup_x64.exe", "setup_x86_64.exe",
                   "install.exe", "install64.exe", "installer.exe", "install.bat",
                   "start.exe", "launch.exe", "launchpad.exe", "setup.msi",
                   "install.msi", "installer.msi")


def optical_devices():
    return sorted(str(p) for p in Path("/dev").glob("sr[0-9]*"))


def _mounts():
    try:
        rows = []
        for line in Path("/proc/mounts").read_text(errors="ignore").splitlines():
            parts = line.split()
            if len(parts) >= 3:
                rows.append((parts[0], parts[1], parts[2]))
        return rows
    except OSError:
        return []


def find_installer(root, max_entries=8000):
    """Zagonski programi na disku (autorun.inf, setup.exe, install.msi ...)."""
    root = Path(root)
    if not root.is_dir():
        return []
    hits = []
    autorun = next((f for f in root.iterdir()
                    if f.is_file() and f.name.lower() == "autorun.inf"), None)
    if autorun:
        try:
            txt = autorun.read_text(errors="ignore")
        except OSError:
            txt = ""
        for m in re.finditer(r"(?im)^\s*(?:open|action|shell[\w. ]*command)\s*=\s*(.+)$", txt):
            rel = m.group(1).strip().strip('"').replace("\\", "/").lstrip("/\\")
            cand = root / rel
            if rel and cand.is_file():
                hits.append((0, cand))
    names = []
    for i, f in enumerate(root.rglob("*")):
        if i > max_entries:
            break
        if f.suffix.lower() not in (".exe", ".msi") or not f.is_file():
            continue
        n = f.name.lower()
        if n in DISC_INSTALLERS:
            names.append((1, f))
        elif "setup" in n or "install" in n:
            names.append((2, f))
    hits += names
    hits.sort(key=lambda t: (t[0], str(t[1])))
    out, seen = [], set()
    for _rank, f in hits:
        if f not in seen:
            seen.add(f)
            out.append(f)
    return out


def disc_scan():
    """Vidni diski: pravi opticni pogoni + montirane ISO slike."""
    rows, out = _mounts(), []
    for dev in optical_devices():
        mp = next((m[1] for m in rows if m[0] == dev), None)
        out.append({"dev": dev, "kind": "CD/DVD pogon", "mount": mp,
                    "path": mp or dev, "ready": bool(mp)})
    for dev, mnt, fst in rows:
        if fst not in DISC_FSTYPES:
            continue
        if any(d["dev"] == dev for d in out):
            continue
        out.append({"dev": dev, "kind": "disk (ISO/slika)", "mount": mnt,
                    "path": mnt, "ready": True})
    return out


def disc_link(prefix, target, letter=None):
    """Poveži mapo ali napravo v prefix kot pogon; vrne črko pogona."""
    dd = Path(prefix) / "dosdevices"
    if not dd.is_dir():
        return None
    used = {p.name[0].upper() for p in dd.iterdir()
            if len(p.name) == 2 and p.name[1] == ":" and p.name[0].isalpha()}
    if not letter:
        letter = next((c for c in DISC_LETTERS if c not in used), None)
    if not letter:
        return None
    link = dd / (letter.lower() + ":")
    try:
        if link.is_symlink() or link.exists():
            if link.is_symlink() and os.path.realpath(link) == os.path.realpath(str(target)):
                return letter
            link.unlink()
        link.symlink_to(str(target))
    except OSError:
        return None
    return letter


def link_discs(prefix, quiet=True):
    """Poveži vse vidne diske v prefix (ce ze niso)."""
    dd = Path(prefix) / "dosdevices"
    if not dd.is_dir():
        return []
    targets = []
    for m in _mounts():
        if m[2] in DISC_FSTYPES and Path(m[1]).is_dir():
            targets.append(m[1])
    for dev in optical_devices():
        mp = next((m[1] for m in _mounts() if m[0] == dev), None)
        targets.append(mp or dev)
    have = set()
    for p in dd.iterdir():
        if len(p.name) == 2 and p.name[1] == ":" and p.is_symlink():
            have.add(os.path.realpath(str(p)))
    linked = []
    for t in targets:
        if os.path.realpath(str(t)) in have:
            continue
        letter = disc_link(prefix, t)
        if letter:
            linked.append((letter, t))
            have.add(os.path.realpath(str(t)))
    if linked and not quiet:
        for letter, t in linked:
            log(f"  disk povezan kot {letter}:  <- {t}")
    return linked


def disc_mount_iso(iso):
    """Naloži ISO sliko (zanka + montaža) brez roota; vrne (naprava, priključna točka)."""
    if not shutil.which("udisksctl"):
        die("Potreben je udisksctl (paket udisks2).")
    iso = Path(iso).expanduser().resolve()
    if not iso.exists():
        die(f"Ne obstaja: {iso}")
    step(f"Nalagam ISO: {iso.name}")
    code, out = run(["udisksctl", "loop-setup", "-f", str(iso)], capture=True)
    m = re.search(r"as (\S+)", out)
    if code or not m:
        die(f"loop-setup ni uspel:\n{out}")
    dev = m.group(1)
    code, out = run(["udisksctl", "mount", "-b", dev], capture=True)
    m2 = re.search(r"at (\S+)", out)
    if code or not m2:
        die(f"Montiranje ni uspelo:\n{out}")
    mp = m2.group(1)
    log(f"  {dev} → {mp}")
    return dev, mp


def disc_release(dev):
    code, out = run(["udisksctl", "unmount", "-b", dev], capture=True)
    log(f"  {dev}: " + ("odmontiran" if code == 0 else out.strip() or "že odmontiran"))
    if dev.startswith("/dev/loop"):
        code, out = run(["udisksctl", "loop-delete", "-b", dev], capture=True)
        log(f"  {dev}: " + ("zanka sproščena" if code == 0 else out.strip()))
    return 0


def cmd_disc(args):
    if args.eject:
        step("Odpenjam diske")
        for d in disc_scan():
            disc_release(d["dev"])
        return 0
    if args.iso:
        disc_mount_iso(args.iso)
    discs = disc_scan()
    if not discs:
        log("Ni nobenega diska.")
        log("  pravi disk:  vstavi CD/DVD (ali priklopi USB pogon) in ponovi")
        log("  ISO slika:   wineforge disc --iso pot/do/igre.iso")
        log("  namestitev:  wineforge disc --install --name igra")
        return 1
    found_installer = None
    for d in discs:
        log(f"\n{d['kind']}: {d['dev']}" +
            (f"  →  {d['mount']}" if d["mount"] else "  (naprava, brez montaze)"))
        path = Path(d["path"])
        if not d["ready"] or not path.is_dir():
            log("  ni medija ali pa mapa ni dostopna")
            continue
        total = sum(1 for _ in path.rglob("*"))
        log(f"  datotek: {total}")
        inst = find_installer(path)
        if inst:
            log("  namestitveni programi:")
            for f in inst[:8]:
                try:
                    log(f"    {f.relative_to(path)}")
                except ValueError:
                    log(f"    {f}")
            found_installer = found_installer or inst[0]
        else:
            log("  ni prepoznanega installerja (setup.exe / install.msi / autorun.inf)")
    if args.link:
        p = prefix_path(args.link)
        if not (p / "system.reg").exists():
            die(f"Prefix ne obstaja: {p}")
        linked = link_discs(p, quiet=False)
        if not linked:
            log("  ni kaj povezati (ali so diski že povezani)")
        return 0
    if args.install is not None:
        target = Path(args.install).expanduser() if args.install else found_installer
        if not target:
            die("Na disku ni nobenega namestitvenega programa.")
        if not Path(target).exists():
            die(f"Ne obstaja: {target}")
        if not Path(target).is_absolute():
            die("Pot do programa na disku naj bo absolutna (glej seznam zgoraj).")
        ensure_ready()
        name = args.name or re.sub(r"(?i)(setup|install|installer|x64|x86)", "",
                                   Path(target).stem).strip(" .-") or "disc-app"
        log(f"\nNameščam {Path(target).name} kot '{name}' ...")
        return cmd_install(argparse.Namespace(
            installer=str(target), name=name, exe=args.exe, interactive=False,
            args=[], keep_staging=False, no_shortcut=False))
    log("\nNaslednji korak:  wineforge disc --install --ime <ime-programa>")
    return 0


# ---------------------------------------------------------------- doctor ----

