LIBRARY secur32
EXPORTS
    AcceptSecurityContext               = WF_AcceptSecurityContext
    AcquireCredentialsHandleA           = WF_AcquireCredentialsHandleA
    AcquireCredentialsHandleW           = WF_AcquireCredentialsHandleW
    AddSecurityPackageA                 = WF_AddSecurityPackageA
    AddSecurityPackageW                 = WF_AddSecurityPackageW
    ApplyControlToken                   = WF_ApplyControlToken
    ChangeAccountPasswordA              = WF_ChangeAccountPasswordA
    ChangeAccountPasswordW              = WF_ChangeAccountPasswordW
    CompleteAuthToken                   = WF_CompleteAuthToken
    DeleteSecurityContext               = WF_DeleteSecurityContext
    DeleteSecurityPackageA              = WF_DeleteSecurityPackageA
    DeleteSecurityPackageW              = WF_DeleteSecurityPackageW
    DecryptMessage                      = WF_DecryptMessage
    EncryptMessage                      = WF_EncryptMessage
    EnumerateSecurityPackagesA          = WF_EnumerateSecurityPackagesA
    EnumerateSecurityPackagesW          = WF_EnumerateSecurityPackagesW
    ExportSecurityContext               = WF_ExportSecurityContext
    FreeContextBuffer                   = WF_FreeContextBuffer
    FreeCredentialsHandle               = WF_FreeCredentialsHandle
    GetUserNameExA                      = WF_GetUserNameExA
    GetUserNameExW                      = WF_GetUserNameExW
    ImpersonateSecurityContext          = WF_ImpersonateSecurityContext
    ImportSecurityContext               = WF_ImportSecurityContext
    InitializeSecurityContextA          = WF_InitializeSecurityContextA
    InitializeSecurityContextW          = WF_InitializeSecurityContextW
    MakeSignature                       = WF_MakeSignature
    QueryContextAttributesA             = WF_QueryContextAttributesA
    QueryContextAttributesW             = WF_QueryContextAttributesW
    QueryCredentialsAttributesA         = WF_QueryCredentialsAttributesA
    QueryCredentialsAttributesW         = WF_QueryCredentialsAttributesW
    QuerySecurityContextToken           = WF_QuerySecurityContextToken
    QuerySecurityPackageInfoA           = WF_QuerySecurityPackageInfoA
    QuerySecurityPackageInfoW           = WF_QuerySecurityPackageInfoW
    RevertSecurityContext               = WF_RevertSecurityContext
    SetContextAttributesA               = WF_SetContextAttributesA
    SetContextAttributesW               = WF_SetContextAttributesW
    SetNamedSecurityProfileW            = WF_SetNamedSecurityProfileW
    VerifySignature                     = WF_VerifySignature
